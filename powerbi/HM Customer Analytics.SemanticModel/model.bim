          },
          {
            "name": "orders_bucket_sort",
            "dataType": "int64",
            "expression": [
              "VAR o = rpt_customer[orders]",
              "RETURN",
              "    SWITCH ( TRUE (), o = 0, BLANK (), o <= 5, o, o <= 9, 6, o <= 19, 7, 8 )"
            ],
            "isDataTypeInferred": true,
            "isHidden": true,
            "lineageTag": "4e69d7a0-0484-4850-b634-e8d08d9f2191",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "orders_bucket",
            "dataType": "string",
            "expression": [
              "VAR o = rpt_customer[orders]",
              "RETURN",
              "    SWITCH ( TRUE (), o = 0, BLANK (), o <= 5, FORMAT ( o, \"0\" ), o <= 9, \"6-9\", o <= 19, \"10-19\", \"20+\" )"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "4a1eb347-7f5f-4c5e-bfb0-c3150bc3e06b",
            "sortByColumn": "orders_bucket_sort",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "fm_score",
            "dataType": "int64",
            "expression": [
              "",
              "IF ( rpt_customer[has_purchased], INT ( ROUND ( ( rpt_customer[f_score] + rpt_customer[m_score] ) / 2, 0 ) ) )"
            ],
            "formatString": "0",
            "isDataTypeInferred": true,
            "lineageTag": "88094599-e529-4c4e-8171-bbf5bfdbe8bb",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "spend_percentile",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "lineageTag": "f7aa5498-c251-4f26-ba24-6885f87015d9",
            "sourceColumn": "spend_percentile",
            "summarizeBy": "none"
          },
          {
            "name": "churn_bucket_sort",
            "dataType": "int64",
            "expression": [
              "IF (",
              "    rpt_customer[is_scored],",
              "    MIN ( INT ( rpt_customer[churn_probability] * 10 ), 9 )",
              ")"
            ],
            "formatString": "0",
            "isDataTypeInferred": true,
            "isHidden": true,
            "lineageTag": "b73e5053-1d59-4cfd-a550-dd3d755311df",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "churn_bucket",
            "dataType": "string",
            "expression": [
              "VAR Step =",
              "    IF (",
              "        rpt_customer[is_scored],",
              "        MIN ( INT ( rpt_customer[churn_probability] * 10 ), 9 )",
              "    )",
              "RETURN",
              "    IF ( NOT ISBLANK ( Step ), FORMAT ( Step * 10, \"0\" ) & \"-\" & FORMAT ( Step * 10 + 10, \"0\" ) & \"%\" )"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "1cd02797-7f91-4fac-a3ba-f54fb1c69141",
            "sortByColumn": "churn_bucket_sort",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "risk_band_sort",
            "dataType": "int64",
            "expression": "IF ( rpt_customer[is_scored], 11 - rpt_customer[value_at_risk_decile] )",
            "formatString": "0",
            "isDataTypeInferred": true,
            "isHidden": true,
            "lineageTag": "0def6278-eaf8-421e-b912-f3677077145f",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "risk_band_label",
            "dataType": "string",
            "expression": [
              "VAR Band = 11 - rpt_customer[value_at_risk_decile]",
              "RETURN",
              "    IF (",
              "        rpt_customer[is_scored],",
              "        IF ( Band = 1, \"Top 10%\", FORMAT ( ( Band - 1 ) * 10 + 1, \"0\" ) & \"-\" & FORMAT ( Band * 10, \"0\" ) & \"%\" )",
              "    )"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "31f6abb8-dd33-4b2d-aa26-7a6c2227b040",
            "sortByColumn": "risk_band_sort",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
        "lineageTag": "3324bd94-6419-47c5-89bd-8c10389f4c9a",
        "partitions": [
          {
            "name": "rpt_customer",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = GoogleBigQuery.Database([BillingProject=\"fashion-cx\", Implementation=\"2.0\"]),",
                "    #\"fashion-cx_Database\" = Source{[Name=\"fashion-cx\",Kind=\"Database\"]}[Data],",
                "    hm_marts_Schema = #\"fashion-cx_Database\"{[Name=\"hm_marts\",Kind=\"Schema\"]}[Data],",
                "    rpt_customer_View = hm_marts_Schema{[Name=\"rpt_customer\",Kind=\"View\"]}[Data]",
                "in",
                "    rpt_customer_View"
              ],
              "type": "m"
            }
          }
        ]
