              },
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "dataType": "double",
            "lineageTag": "5f2ca1cc-6a64-43b4-8468-5cd8cdc80265",
            "sourceColumn": "avg_price",
            "summarizeBy": "none"
          },
          {
            "name": "price_tier",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "formatString": "0",
            "lineageTag": "063374ad-c59f-4a7d-a54b-e51b083da91b",
            "sourceColumn": "price_tier",
            "summarizeBy": "none"
          },
          {
            "name": "first_sale_date",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              },
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ],
            "dataType": "dateTime",
            "formatString": "Long Date",
            "lineageTag": "244ee741-e11f-4298-b607-6effa1905067",
            "sourceColumn": "first_sale_date",
            "summarizeBy": "none"
          },
          {
            "name": "last_sale_date",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              },
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ],
            "dataType": "dateTime",
            "formatString": "Long Date",
            "lineageTag": "a84e9bc1-ded8-487a-bf53-9117f6c9a4dc",
            "sourceColumn": "last_sale_date",
            "summarizeBy": "none"
          },
          {
            "name": "has_sold",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "boolean",
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "lineageTag": "f3edc3e7-e73e-4e2f-a137-f92bb9813805",
