          },
          {
            "name": "same_season_sort",
            "dataType": "int64",
            "expression": [
              "VAR LastDay = MAX ( agg_sales_daily[purchase_date] )",
              "VAR CovidStart = DATE ( 2020, 3, 1 )",
              "VAR ThisDay = dim_date[date]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ThisDay >= CovidStart && ThisDay <= LastDay, 2,",
              "        ThisDay >= EDATE ( CovidStart, -12 ) && ThisDay <= EDATE ( LastDay, -12 ), 1",
              "    )"
            ],
            "formatString": "0",
            "isDataTypeInferred": true,
            "isHidden": true,
            "lineageTag": "be08e24e-259a-4df4-b250-4513656ff802",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "same_season_period",
            "dataType": "string",
            "expression": [
              "VAR LastDay = MAX ( agg_sales_daily[purchase_date] )",
              "VAR CovidStart = DATE ( 2020, 3, 1 )",
              "VAR ThisDay = dim_date[date]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ThisDay >= CovidStart && ThisDay <= LastDay, \"Mar-\" & FORMAT ( LastDay, \"mmm yyyy\" ),",
              "        ThisDay >= EDATE ( CovidStart, -12 ) && ThisDay <= EDATE ( LastDay, -12 ),",
              "            \"Mar-\" & FORMAT ( EDATE ( LastDay, -12 ), \"mmm yyyy\" )",
              "    )"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "ce3049b4-d74d-4820-a4a1-707b3dc1d35a",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
        "dataCategory": "Time",
        "lineageTag": "5de94480-5d2a-49cf-aba7-85b9c84aa4a2",
        "partitions": [
