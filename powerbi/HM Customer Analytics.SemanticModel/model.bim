          }
        ],
        "lineageTag": "9e1304af-f3af-4faf-a477-346b37c11e4b",
        "partitions": [
          {
            "name": "dim_product",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = GoogleBigQuery.Database([BillingProject=\"fashion-cx\", Implementation=\"2.0\"]),",
                "    #\"fashion-cx_Database\" = Source{[Name=\"fashion-cx\",Kind=\"Database\"]}[Data],",
                "    hm_marts_Schema = #\"fashion-cx_Database\"{[Name=\"hm_marts\",Kind=\"Schema\"]}[Data],",
                "    dim_product_Table = hm_marts_Schema{[Name=\"dim_product\",Kind=\"Table\"]}[Data],",
                "  #\"Removed columns\" = Table.RemoveColumns(dim_product_Table, {\"description\"})",
                "in",
                "    #\"Removed columns\""
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "_Measures",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "columns": [
          {
            "name": "Column1",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "isHidden": true,
            "lineageTag": "88825ad6-7e2d-4fae-ad2c-afdc4a5886c5",
            "sourceColumn": "Column1",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "7ce71aa1-0936-4e52-ba32-b599bec1cc35",
        "measures": [
          {
            "name": "Customers",
            "description": "Customers in the current filter context (one row per customer in rpt_customer).",
            "displayFolder": "1 Customer base",
            "expression": "COUNTROWS ( rpt_customer )",
            "formatString": "#,0",
            "lineageTag": "9f8407a5-8136-4cfd-bd8f-a2ba5a79e792"
          },
          {
            "name": "Purchasing Customers",
            "description": "Customers with at least one purchase in the data window.",
            "displayFolder": "1 Customer base",
            "expression": "CALCULATE ( [Customers], rpt_customer[has_purchased] = TRUE () )",
            "formatString": "#,0",
            "lineageTag": "c8ed0902-09b4-4cbc-880c-9537f1227ae6"
          },
          {
            "name": "Omnichannel Customer Share %",
            "description": "Share of purchasing customers who bought both in store and online.",
            "displayFolder": "1 Customer base",
            "expression": "DIVIDE ( CALCULATE ( [Customers], rpt_customer[channel_preference] = \"Omnichannel\" ), [Purchasing Customers] )",
            "formatString": "0.0%",
            "lineageTag": "e5a14143-f460-4c16-a904-94576ccfefe7"
          },
          {
            "name": "Active Club Member Share %",
            "description": "Share of customers with ACTIVE club membership.",
            "displayFolder": "1 Customer base",
            "expression": "DIVIDE ( CALCULATE ( [Customers], rpt_customer[club_member_status] = \"ACTIVE\" ), [Customers] )",
            "formatString": "0.0%",
            "lineageTag": "495ff791-2610-4536-a2f6-9f929789f187"
          },
          {
            "name": "Avg Customer Age",
            "description": "Average age of customers with a known age.",
            "displayFolder": "1 Customer base",
            "expression": "AVERAGE ( rpt_customer[age] )",
            "formatString": "#,0.0",
            "lineageTag": "d53ed562-4c3d-4acb-b3d4-66843f73e3a5"
          },
          {
            "name": "Active Customers",
            "description": "Distinct customers purchasing per month. By month: that month's count. Across months: average per full month (partial first and last months excluded). Never summed across months.",
            "displayFolder": "1 Customer base",
            "expression": "AVERAGEX ( CALCULATETABLE ( VALUES ( agg_monthly_kpis[activity_month] ), agg_monthly_kpis[is_partial_month] = FALSE () ), CALCULATE ( SUM ( agg_monthly_kpis[active_customers] ) ) )",
            "formatString": "#,0",
            "lineageTag": "eda2d00e-1341-4626-971a-7a81530742ab"
          },
          {
            "name": "New Customers",
            "description": "Customers whose first purchase in the data window falls in the period. Before Mar 2019 this includes existing customers first seen in the data (warm-up).",
            "displayFolder": "1 Customer base",
            "expression": "SUM ( agg_monthly_kpis[new_customers] )",
            "formatString": "#,0",
            "lineageTag": "885083bf-c976-4010-bdef-e08c24d1a671"
          },
          {
            "name": "Returning Customer Share %",
            "description": "Share of active customers who had purchased in an earlier month.",
            "displayFolder": "1 Customer base",
            "expression": "DIVIDE ( SUM ( agg_monthly_kpis[returning_customers] ), SUM ( agg_monthly_kpis[active_customers] ) )",
            "formatString": "0.0%",
            "lineageTag": "2fe9afdd-f11d-40bd-9e7f-a6563e5c6802"
          },
          {
            "name": "Online Customer Share %",
            "description": "Share of active customers who bought at least one item online in the month.",
            "displayFolder": "1 Customer base",
            "expression": "DIVIDE ( SUM ( agg_monthly_kpis[online_customers] ), SUM ( agg_monthly_kpis[active_customers] ) )",
            "formatString": "0.0%",
            "lineageTag": "a6694dff-1c69-4e86-933c-2e8594520064"
          },
          {
            "name": "Orders",
            "description": "Orders, approximated as customer + date + channel (no receipt ID in source).",
            "displayFolder": "1 Customer base",
            "expression": "SUM ( agg_monthly_kpis[orders] )",
            "formatString": "#,0",
            "lineageTag": "94e82377-59f3-4995-b75f-a555c93514db"
          },
          {
            "name": "Avg Order Value",
            "description": "Average scaled spend per order. Scaled prices, not real currency.",
            "displayFolder": "1 Customer base",
            "expression": "DIVIDE ( SUM ( agg_monthly_kpis[sales_amount] ), [Orders] )",
            "formatString": "#,0.000",
            "lineageTag": "562d87b9-6314-4e5a-b49b-23c1802899bc"
          },
          {
            "name": "Units per Order",
            "description": "Average units per order.",
            "displayFolder": "1 Customer base",
            "expression": "DIVIDE ( SUM ( agg_monthly_kpis[units] ), [Orders] )",
            "formatString": "#,0.00",
            "lineageTag": "d7e3b529-33a1-4db1-88fb-c2d6179c21eb"
          },
          {
            "name": "Cohort Retention %",
            "description": "Share of a cohort purchasing N months after its first purchase month. Combining cohorts divides summed active customers by summed cohort size.",
            "displayFolder": "2 Cohorts",
            "expression": "DIVIDE ( SUM ( cohort_retention[active_customers] ), SUM ( cohort_retention[cohort_size] ) )",
            "formatString": "0.0%",
            "lineageTag": "5325a6fd-2f91-4767-a48d-3b3f9b9cc6ed"
          },
          {
            "name": "Month 1 Retention %",
            "description": "Retention 1 month(s) after first purchase, Standard cohorts only (Mar 2019 onward), partial last month excluded.",
            "displayFolder": "2 Cohorts",
            "expression": "CALCULATE ( [Cohort Retention %], cohort_retention[months_since_first_purchase] = 1, cohort_retention[cohort_type] = \"Standard\", cohort_retention[is_partial_activity_month] = FALSE () )",
            "formatString": "0.0%",
            "lineageTag": "d1c52480-f1a4-416c-a183-467574c5436b"
          },
          {
            "name": "Month 3 Retention %",
            "description": "Retention 3 month(s) after first purchase, Standard cohorts only (Mar 2019 onward), partial last month excluded.",
            "displayFolder": "2 Cohorts",
            "expression": "CALCULATE ( [Cohort Retention %], cohort_retention[months_since_first_purchase] = 3, cohort_retention[cohort_type] = \"Standard\", cohort_retention[is_partial_activity_month] = FALSE () )",
            "formatString": "0.0%",
            "lineageTag": "11554373-5456-41a4-8346-c659dafa7284"
          },
          {
            "name": "Month 6 Retention %",
            "description": "Retention 6 month(s) after first purchase, Standard cohorts only (Mar 2019 onward), partial last month excluded.",
            "displayFolder": "2 Cohorts",
            "expression": "CALCULATE ( [Cohort Retention %], cohort_retention[months_since_first_purchase] = 6, cohort_retention[cohort_type] = \"Standard\", cohort_retention[is_partial_activity_month] = FALSE () )",
            "formatString": "0.0%",
            "lineageTag": "8690efa3-0a29-46f7-9172-a241f123c7c9"
          },
          {
            "name": "Month 12 Retention %",
            "description": "Retention 12 month(s) after first purchase, Standard cohorts only (Mar 2019 onward), partial last month excluded.",
            "displayFolder": "2 Cohorts",
            "expression": "CALCULATE ( [Cohort Retention %], cohort_retention[months_since_first_purchase] = 12, cohort_retention[cohort_type] = \"Standard\", cohort_retention[is_partial_activity_month] = FALSE () )",
            "formatString": "0.0%",
            "lineageTag": "297d9ff3-9b2e-4b72-8adc-586ef63d46a7"
          },
          {
            "name": "Customers Acquired (Standard Cohorts)",
            "description": "New customers in Standard cohorts (Mar 2019 onward).",
            "displayFolder": "2 Cohorts",
            "expression": "CALCULATE ( SUM ( cohort_retention[cohort_size] ), cohort_retention[months_since_first_purchase] = 0, cohort_retention[cohort_type] = \"Standard\" )",
            "formatString": "#,0",
            "lineageTag": "4ac45a5f-0d46-425a-938b-1a19e43a8fe0"
          },
          {
            "name": "Customer Share %",
            "description": "Share of customers in the segment, relative to all segments.",
            "displayFolder": "3 Segments",
            "expression": "DIVIDE ( [Customers], CALCULATE ( [Customers], REMOVEFILTERS ( rpt_customer[rfm_segment], rpt_customer[segment_sort_order] ) ) )",
            "formatString": "0.0%",
            "lineageTag": "7b53e739-3378-4f3b-b853-fe3e3337a6aa"
          },
          {
            "name": "Lifetime Spend",
            "description": "Lifetime scaled spend in the data window. Scaled prices, not real currency.",
            "displayFolder": "3 Segments",
            "expression": "SUM ( rpt_customer[total_spend] )",
            "formatString": "#,0",
            "lineageTag": "f438c077-73b5-4660-bdb6-e47fb46e4ac2"
          },
          {
            "name": "Spend Share %",
            "description": "Share of lifetime scaled spend generated by the segment.",
            "displayFolder": "3 Segments",
            "expression": "DIVIDE ( [Lifetime Spend], CALCULATE ( [Lifetime Spend], REMOVEFILTERS ( rpt_customer[rfm_segment], rpt_customer[segment_sort_order] ) ) )",
            "formatString": "0.0%",
            "lineageTag": "827969ae-31e5-4e0b-97dd-086ac6eed37c"
          },
          {
            "name": "Spend Concentration",
            "description": "Spend share divided by customer share. Above 1x means the segment spends more than its size suggests.",
            "displayFolder": "3 Segments",
            "expression": "DIVIDE ( [Spend Share %], [Customer Share %] )",
            "formatString": "0.0\"x\"",
            "lineageTag": "b7947f7e-f48f-42cc-b63d-1406c163be6e"
          },
          {
            "name": "Spend per Customer",
            "description": "Average lifetime scaled spend per customer.",
            "displayFolder": "3 Segments",
            "expression": "DIVIDE ( [Lifetime Spend], [Customers] )",
            "formatString": "#,0.000",
            "lineageTag": "fd44b190-4904-4fc6-8e90-ba1a582eda64"
          },
          {
            "name": "Orders per Customer",
            "description": "Average lifetime orders per customer.",
            "displayFolder": "3 Segments",
            "expression": "DIVIDE ( SUM ( rpt_customer[orders] ), [Customers] )",
            "formatString": "#,0.0",
            "lineageTag": "d10ccdd9-662c-4d16-8ab6-c0e02b3f9187"
          },
          {
            "name": "Avg Days Since Last Purchase",
            "description": "Average recency in days as of the last date in the data.",
            "displayFolder": "3 Segments",
            "expression": "AVERAGE ( rpt_customer[recency_days] )",
            "formatString": "#,0",
            "lineageTag": "ec3737f1-0545-46c7-951a-bdb543cd048b"
          },
          {
            "name": "Observed Churn Rate %",
            "description": "Share of customers active in the prior 365 days with no purchase in the 90 days after the cutoff. Compare within one cutoff date.",
            "displayFolder": "4 Churn",
            "expression": "DIVIDE ( SUM ( rpt_churn_drivers[churned_customers] ), SUM ( rpt_churn_drivers[customers] ) )",
            "formatString": "0.0%",
            "lineageTag": "5289cfc4-ee1b-40de-8263-14ebde472d44"
          },
          {
            "name": "Active Base at Cutoff",
            "description": "Customers active in the 365 days before the cutoff date.",
            "displayFolder": "4 Churn",
            "expression": "SUM ( rpt_churn_drivers[customers] )",
            "formatString": "#,0",
            "lineageTag": "7ca4c39e-bf4d-498a-82ad-8e52dbdb9791"
          },
          {
            "name": "Scored Customers",
            "description": "Customers active in the last 365 days with churn and value predictions.",
            "displayFolder": "4 Churn",
            "expression": "CALCULATE ( [Customers], rpt_customer[is_scored] = TRUE () )",
            "formatString": "#,0",
            "lineageTag": "a925d8fb-f6ea-4200-8d87-3f1fdee3e6c7"
          },
          {
            "name": "Avg Churn Probability",
            "description": "Average predicted probability of no purchase in the next 90 days.",
            "displayFolder": "4 Churn",
            "expression": "AVERAGE ( rpt_customer[churn_probability] )",
            "formatString": "0.0%",
            "lineageTag": "0c4d6f9f-bca0-4024-82f8-394beeef5b08"
          },
          {
            "name": "Expected Churners",
            "description": "Expected number of customers who will not purchase in the next 90 days (sum of probabilities).",
            "displayFolder": "4 Churn",
            "expression": "SUM ( rpt_customer[churn_probability] )",
            "formatString": "#,0",
            "lineageTag": "9fd4ce22-0cef-400d-8f9b-d8afb08c52dd"
          },
          {
            "name": "High Risk Customers",
            "description": "Scored customers with churn probability of 70% or more.",
            "displayFolder": "4 Churn",
            "expression": "CALCULATE ( [Customers], rpt_customer[churn_risk_band] = \"High\" )",
            "formatString": "#,0",
            "lineageTag": "94307e38-ffd5-4fd6-836e-ba369bdeef0a"
          },
          {
            "name": "High Risk Share %",
            "description": "Share of scored customers in the High risk band.",
            "displayFolder": "4 Churn",
            "expression": "DIVIDE ( [High Risk Customers], [Scored Customers] )",
            "formatString": "0.0%",
            "lineageTag": "a5e9084e-f349-4ec6-8812-e9004c652fd2"
          },
          {
            "name": "Units",
            "description": "Units sold.",
            "displayFolder": "5 Products and channels",
            "expression": "SUM ( agg_sales_daily[units] )",
            "formatString": "#,0",
            "lineageTag": "5e684f84-5a5f-4dfb-9ddb-812ab54a7961"
          },
          {
            "name": "Spend",
            "description": "Scaled spend. Scaled prices, not real currency.",
            "displayFolder": "5 Products and channels",
            "expression": "SUM ( agg_sales_daily[sales_amount] )",
            "formatString": "#,0",
            "lineageTag": "a67d657d-1347-4be4-b146-8346a2d7d9c2"
          },
          {
            "name": "Unit Share %",
            "description": "Share of units within the visible index groups.",
            "displayFolder": "5 Products and channels",
            "expression": "DIVIDE ( [Units], CALCULATE ( [Units], REMOVEFILTERS ( agg_sales_daily[index_group] ) ) )",
            "formatString": "0.0%",
            "lineageTag": "c160d91b-670f-47fd-9a79-b9612e35ba9a"
          },
          {
            "name": "Spend Share of Selection %",
            "description": "Share of scaled spend within the current selection (respects slicers).",
            "displayFolder": "5 Products and channels",
            "expression": "DIVIDE ( [Spend], CALCULATE ( [Spend], ALLSELECTED ( agg_sales_daily ) ) )",
            "formatString": "0.0%",
            "lineageTag": "584293dd-9426-4324-933c-154433daef4b"
          },
          {
            "name": "Online Unit Share %",
            "description": "Share of units bought online. Channel mapping 1 = Store, 2 = Online is community-established.",
            "displayFolder": "5 Products and channels",
            "expression": "DIVIDE ( CALCULATE ( [Units], agg_sales_daily[channel] = \"Online\" ), [Units] )",
            "formatString": "0.0%",
            "lineageTag": "21f344e0-b24f-4dcc-a342-3cb55a6d789d"
          },
          {
            "name": "Avg Unit Price",
            "description": "Average scaled price per unit. Relative only.",
            "displayFolder": "5 Products and channels",
            "expression": "DIVIDE ( [Spend], [Units] )",
            "formatString": "0.0000",
            "lineageTag": "22dbbd43-eb76-4d55-9c4b-e17e1482e216"
          },
          {
            "name": "Units PY",
            "description": "Units in the same period one year earlier.",
            "displayFolder": "5 Products and channels",
            "expression": "CALCULATE ( [Units], SAMEPERIODLASTYEAR ( dim_date[date] ) )",
            "formatString": "#,0",
            "lineageTag": "a7c2f4f8-c72b-4570-b254-8c50d1bca497"
          },
          {
            "name": "Units YoY %",
            "description": "Year-over-year change in units. Blank where the prior year is outside the data window.",
            "displayFolder": "5 Products and channels",
            "expression": "DIVIDE ( [Units] - [Units PY], [Units PY] )",
            "formatString": "0.0%",
            "lineageTag": "941cc9dc-522e-45c6-8a6f-1b8d13497ac4"
          },
          {
            "name": "Value at Risk",
            "description": "Expected scaled spend lost to churn: churn probability x quarterly spend over the past year.",
            "displayFolder": "6 Where to act",
            "expression": "SUM ( rpt_customer[value_at_risk] )",
            "formatString": "#,0.0",
            "lineageTag": "0f48cd76-7d38-43f0-9223-94e835064194"
          },
          {
            "name": "Value at Risk Share %",
            "description": "Share of total value at risk held by the selected customers.",
            "displayFolder": "6 Where to act",
            "expression": "DIVIDE ( [Value at Risk], CALCULATE ( [Value at Risk], REMOVEFILTERS ( rpt_customer ) ) )",
            "formatString": "0.0%",
            "lineageTag": "c62fab17-54b4-4613-85bf-58c8eec3a783"
          },
          {
            "name": "Scored Customer Share %",
            "description": "Share of all scored customers in the selection.",
            "displayFolder": "6 Where to act",
            "expression": "DIVIDE ( [Scored Customers], CALCULATE ( [Scored Customers], REMOVEFILTERS ( rpt_customer ) ) )",
            "formatString": "0.0%",
            "lineageTag": "d0f00877-3f32-4027-89d1-2cc6292106d0"
          },
          {
            "name": "Targeting Efficiency",
            "description": "Value-at-risk share divided by customer share. 3x means each targeted customer covers three times the average risk.",
            "displayFolder": "6 Where to act",
            "expression": "DIVIDE ( [Value at Risk Share %], [Scored Customer Share %] )",
            "formatString": "0.0\"x\"",
            "lineageTag": "f649b733-9847-486f-8dbb-b6d8dabf8f70"
          },
          {
            "name": "Top Decile Customers",
            "description": "Customers in the top 10% by value at risk (the retention target list).",
            "displayFolder": "6 Where to act",
            "expression": "CALCULATE ( [Customers], rpt_customer[value_at_risk_decile] = 10 )",
            "formatString": "#,0",
            "lineageTag": "ef23f522-f673-44c2-b215-15d43661f80b"
          },
          {
            "name": "Top Decile Value at Risk Share %",
            "description": "Share of value at risk held by the top value-at-risk decile.",
            "displayFolder": "6 Where to act",
            "expression": "DIVIDE ( CALCULATE ( [Value at Risk], rpt_customer[value_at_risk_decile] = 10 ), CALCULATE ( [Value at Risk], REMOVEFILTERS ( rpt_customer[value_at_risk_decile] ) ) )",
            "formatString": "0.0%",
            "lineageTag": "6d294bbe-04bb-4c74-9256-d22938c96e0a"
          },
          {
            "name": "Forecast Spend Next 90 Days",
            "description": "BigQuery ML forecast of scaled spend in the next 90 days. Reliable for totals and ranking, rough for individuals.",
            "displayFolder": "6 Where to act",
            "expression": "SUM ( rpt_customer[predicted_spend_next_90d] )",
            "formatString": "#,0.0",
            "lineageTag": "7708aa8e-d77f-4671-b2d6-26200a6e8e6f"
          },
          {
            "name": "Churn Model ROC AUC",
            "description": "Churn model ROC AUC on the unseen Jun 2020 test split.",
            "displayFolder": "7 Model notes",
            "expression": "0.803",
            "formatString": "0.0%",
            "lineageTag": "fa6c4935-1c27-48e9-bb10-442353848cec"
          },
          {
            "name": "Churn Model Precision",
            "description": "Of customers flagged as churners, share who actually churned (test split).",
            "displayFolder": "7 Model notes",
            "expression": "0.728",
            "formatString": "0.0%",
            "lineageTag": "ed2b9eec-c474-47f9-b083-d00691fc0c4a"
          },
          {
            "name": "Churn Model Recall",
            "description": "Of actual churners, share the model caught (test split).",
            "displayFolder": "7 Model notes",
            "expression": "0.823",
            "formatString": "0.0%",
            "lineageTag": "eff8f89d-a66c-4594-a048-9a980ce2cb85"
          },
          {
            "name": "Value Model R Squared",
            "description": "Share of variation in next-90-day spend explained by the value model (test split).",
            "displayFolder": "7 Model notes",
            "expression": "0.362",
            "formatString": "0.000",
            "lineageTag": "7d401de9-1db1-449b-9901-67849a0460e8"
          },
          {
            "name": "Value Model Error Reduction %",
            "description": "Mean absolute error reduction versus predicting the 2019 average (test split).",
            "displayFolder": "7 Model notes",
            "expression": "0.275",
            "formatString": "0.0%",
            "lineageTag": "450d58a0-1df4-41b1-a8c4-ab7368a0c1b3"
          },
          {
            "name": "Report Subtitle",
            "description": "Report subtitle calculated from the full dataset.",
            "displayFolder": "0 Template",
            "expression": [
              "",
              "VAR TotalUnits = CALCULATE ( [Units], REMOVEFILTERS () )",
              "VAR TotalCustomers = CALCULATE ( [Customers], REMOVEFILTERS () )",
              "VAR PeriodStart = CALCULATE ( MIN ( dim_date[date] ), REMOVEFILTERS () )",
              "VAR PeriodEnd = CALCULATE ( MAX ( dim_date[date] ), REMOVEFILTERS () )",
              "RETURN",
              "    \"by Zia Malik  ·  \"",
              "        & FORMAT ( TotalUnits / 1000000, \"0.0\" ) & \"M purchases from \"",
              "        & FORMAT ( TotalCustomers / 1000000, \"0.00\" ) & \"M customers  ·  \"",
              "        & FORMAT ( PeriodStart, \"mmm yyyy\" ) & \" - \" & FORMAT ( PeriodEnd, \"mmm yyyy\" )"
            ],
            "lineageTag": "4eb80db9-4bf4-47ae-9d3c-d996ddbc9cf0"
          },
          {
            "name": "Footer Note",
            "description": "Footer source and disclaimer line, with the data end date calculated.",
            "displayFolder": "0 Template",
            "expression": [
              "",
              "VAR PeriodEnd = CALCULATE ( MAX ( dim_date[date] ), REMOVEFILTERS () )",
              "RETURN",
              "    \"Source: H&M Personalized Fashion Recommendations (Kaggle), non-commercial use  ·  Data to \"",
              "        & FORMAT ( PeriodEnd, \"d mmm yyyy\" )",
              "        & \"  ·  Prices scaled by H&M, not real currency  ·  Independent analysis, not affiliated with H&M  ·  BigQuery · Dataform · BigQuery ML · Power BI\""
            ],
            "lineageTag": "c5b7a814-6232-46a5-967f-3c40b20be13e"
          },
          {
            "name": "New Customers per Month",
            "description": "Average new customers per acquisition month, excluding the 6-month warm-up and the partial last month.",
            "displayFolder": "Rail 01 Base",
            "expression": [
              "",
              "VAR FirstMonth = CALCULATE ( MIN ( rpt_customer[cohort_month] ), REMOVEFILTERS () )",
              "VAR LastMonth = CALCULATE ( MAX ( rpt_customer[cohort_month] ), REMOVEFILTERS () )",
              "VAR StandardMonths =",
              "    CALCULATETABLE (",
              "        VALUES ( rpt_customer[cohort_month] ),",
              "        rpt_customer[cohort_month] >= EDATE ( FirstMonth, 6 ),",
              "        rpt_customer[cohort_month] < LastMonth",
              "    )",
              "RETURN",
              "    AVERAGEX ( StandardMonths, CALCULATE ( [Customers] ) )"
            ],
            "formatString": "#,0",
            "lineageTag": "a0f52701-0e86-4252-be8f-33da710b8719"
          },
          {
            "name": "Ref Customers",
            "description": "Rail comparison line for Customers.",
            "displayFolder": "Rail 01 Base",
            "expression": [
              "",
              "FORMAT ( DIVIDE ( [Purchasing Customers], [Customers] ), \"0.0%\" ) & \" have bought at least once\""
            ],
            "lineageTag": "5d7717b1-9aac-4af4-ba57-6e2856766c0a"
          },
          {
            "name": "Ref New Customers per Month",
            "description": "Rail comparison line: peak acquisition month after the warm-up.",
            "displayFolder": "Rail 01 Base",
            "expression": [
              "VAR FirstMonth = CALCULATE ( MIN ( rpt_customer[cohort_month] ), REMOVEFILTERS () )",
              "VAR LastMonth = CALCULATE ( MAX ( rpt_customer[cohort_month] ), REMOVEFILTERS () )",
              "VAR MonthTable =",
              "    ADDCOLUMNS (",
              "        CALCULATETABLE (",
              "            VALUES ( rpt_customer[cohort_month] ),",
              "            rpt_customer[cohort_month] >= EDATE ( FirstMonth, 6 ),",
              "            rpt_customer[cohort_month] < LastMonth",
              "        ),",
              "        \"@New\", CALCULATE ( [Customers] )",
              "    )",
              "VAR PeakRow = TOPN ( 1, MonthTable, [@New], DESC )",
              "RETURN",
              "    \"Busiest month: \" & FORMAT ( MAXX ( PeakRow, rpt_customer[cohort_month] ), \"mmm yyyy\" ) & \" (\"",
              "        & FORMAT ( MAXX ( PeakRow, [@New] ) / 1000, \"0\" ) & \"K)\""
            ],
            "lineageTag": "17c94701-8c11-4ba0-83ee-614137e1ddff"
          },
          {
            "name": "Ref Omnichannel",
            "description": "Rail comparison line for omnichannel share.",
            "displayFolder": "Rail 01 Base",
            "expression": [
              "",
              "VAR Base = [Purchasing Customers]",
              "VAR OnlineOnly = DIVIDE ( CALCULATE ( [Customers], rpt_customer[channel_preference] = \"Online only\" ), Base )",
              "VAR StoreOnly = DIVIDE ( CALCULATE ( [Customers], rpt_customer[channel_preference] = \"Store only\" ), Base )",
              "RETURN",
              "    \"Online only \" & FORMAT ( OnlineOnly, \"0%\" ) & \"  ·  Store only \" & FORMAT ( StoreOnly, \"0%\" )"
            ],
            "lineageTag": "5f2524f2-2480-456a-87a1-89e343918f91"
          },
          {
            "name": "Ref Club Members",
            "description": "Rail comparison line for active club members.",
            "displayFolder": "Rail 01 Base",
            "expression": [
              "",
              "\"Average age \" & FORMAT ( [Avg Customer Age], \"0\" )"
            ],
            "lineageTag": "898d923d-ceed-44bf-b71c-3ab569e77507"
          },
          {
            "name": "Scope Label",
            "description": "Who is in scope, based on the age filter. Reused in every page headline.",
            "displayFolder": "0 Template",
            "expression": [
              "",
              "VAR SelectedBands = VALUES ( dim_age_band[age_band] )",
              "VAR BandCount = COUNTROWS ( SelectedBands )",
              "VAR OneBand = SELECTEDVALUE ( dim_age_band[age_band] )",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        NOT ISFILTERED ( dim_age_band[age_band] ), \"H&M customers\",",
              "        BandCount = 1 && OneBand = \"Unknown\", \"Customers with unknown age\",",
              "        BandCount = 1, \"Customers aged \" & OneBand,",
              "        \"Customers in \" & BandCount & \" age bands\"",
              "    )"
            ],
            "lineageTag": "0c6c6846-7291-4807-af12-b4eadde70865"
          },
          {
            "name": "Headline 01",
            "description": "Page 01 headline: the dominant shopping channel for the customers in scope.",
            "displayFolder": "Page 01 Base",
            "expression": [
              "VAR Base = [Purchasing Customers]",
              "VAR OnlineOnly = DIVIDE ( CALCULATE ( [Customers], rpt_customer[channel_preference] = \"Online only\" ), Base )",
              "VAR StoreOnly = DIVIDE ( CALCULATE ( [Customers], rpt_customer[channel_preference] = \"Store only\" ), Base )",
              "RETURN",
              "    [Scope Label] & \": \" & FORMAT ( OnlineOnly, \"0%\" ) & \" shop only online, \" & FORMAT ( StoreOnly, \"0%\" ) & \" only in stores\""
            ],
            "lineageTag": "595f28b7-0eff-484c-afd3-13e4628f0ce2"
          },
          {
            "name": "Subline 01",
            "description": "Page 01 supporting line.",
            "displayFolder": "Page 01 Base",
            "expression": [
              "FORMAT ( [Customers], \"#,0\" ) & \" customers  ·  \" & FORMAT ( [Omnichannel Customer Share %], \"0%\" )",
              "    & \" shop both online and in stores  ·  who they are, when they joined and where they shop\""
            ],
            "lineageTag": "df2ac2e9-2966-46f7-b834-eca536a91719"
          },
          {
            "name": "Color 01 Acquisition",
            "description": "Column color: camel = warm-up, black = pre-COVID, denim = COVID, gray = partial month.",
            "displayFolder": "Page 01 Base",
            "expression": [
              "",
              "VAR ThisMonth = MAX ( rpt_customer[cohort_month] )",
              "VAR FirstMonth = CALCULATE ( MIN ( rpt_customer[cohort_month] ), REMOVEFILTERS () )",
              "VAR LastMonth = CALCULATE ( MAX ( rpt_customer[cohort_month] ), REMOVEFILTERS () )",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ThisMonth = LastMonth, \"#C4C4C4\",",
              "        ThisMonth < EDATE ( FirstMonth, 6 ), \"#B8977E\",",
              "        ThisMonth >= DATE ( 2020, 3, 1 ), \"#3E5C76\",",
              "        \"#111111\"",
              "    )"
            ],
            "lineageTag": "f52d51aa-9667-4237-bd6b-a1f23e290c91"
          },
          {
            "name": "Title 01 Acquisition",
            "description": "Page 01 acquisition chart title: peak month and COVID vs prior-12-months comparison.",
            "displayFolder": "Page 01 Base",
            "expression": [
              "VAR FirstMonth = CALCULATE ( MIN ( rpt_customer[cohort_month] ), REMOVEFILTERS () )",
              "VAR LastMonth = CALCULATE ( MAX ( rpt_customer[cohort_month] ), REMOVEFILTERS () )",
              "VAR CovidStart = DATE ( 2020, 3, 1 )",
              "VAR MonthTable =",
              "    ADDCOLUMNS (",
              "        CALCULATETABLE (",
              "            VALUES ( rpt_customer[cohort_month] ),",
              "            rpt_customer[cohort_month] >= EDATE ( FirstMonth, 6 ),",
              "            rpt_customer[cohort_month] < LastMonth",
              "        ),",
              "        \"@New\", CALCULATE ( [Customers] )",
              "    )",
              "VAR PeakRow = TOPN ( 1, MonthTable, [@New], DESC )",
              "VAR PeakMonth = MAXX ( PeakRow, rpt_customer[cohort_month] )",
              "VAR PeakNew = MAXX ( PeakRow, [@New] )",
              "VAR PreCovidAvg =",
              "    AVERAGEX ( FILTER ( MonthTable, rpt_customer[cohort_month] >= EDATE ( CovidStart, -12 ) && rpt_customer[cohort_month] < CovidStart ), [@New] )",
              "VAR CovidAvg = AVERAGEX ( FILTER ( MonthTable, rpt_customer[cohort_month] >= CovidStart ), [@New] )",
              "VAR Change = DIVIDE ( CovidAvg - PreCovidAvg, PreCovidAvg )",
              "RETURN",
              "    \"New customers peaked in \" & FORMAT ( PeakMonth, \"mmm yyyy\" ) & \" (\" & FORMAT ( PeakNew / 1000, \"0\" ) & \"K); during COVID, \"",
              "        & FORMAT ( ABS ( Change ), \"0%\" ) & IF ( Change >= 0, \" more\", \" fewer\" ) & \" joined each month\""
            ],
            "lineageTag": "80e9d76b-cdee-4f1c-a86f-abe4b97956ad"
          },
          {
            "name": "Journey Customers",
            "description": "Customers reaching each journey stage (stages are nested).",
            "displayFolder": "Page 01 Base",
            "expression": [
              "",
              "SWITCH (",
              "    SELECTEDVALUE ( dim_journey_stage[stage_sort] ),",
              "    1, [Customers],",
              "    2, [Purchasing Customers],",
              "    3, CALCULATE ( [Customers], rpt_customer[orders] >= 2 ),",
              "    4, CALCULATE ( [Customers], rpt_customer[orders] >= 5 ),",
              "    5, CALCULATE ( [Customers], rpt_customer[orders] >= 10 )",
              ")"
            ],
            "formatStringDefinition": {
              "expression": [
                "",
                "VAR StageValue = [Journey Customers]",
                "VAR AllCustomers = [Customers]",
                "VAR Pct = DIVIDE ( StageValue, AllCustomers )",
                "RETURN",
                "    \"\"\"\" & FORMAT ( StageValue / 1000, \"#,0\" ) & \"K  (\" & FORMAT ( Pct, \"0%\" ) & \")\"\"\"",
                ""
              ]
            },
            "lineageTag": "cadd250b-3f0e-4c32-a89d-cf0b827b41b6"
          },
          {
            "name": "Color 01 Journey",
            "description": "Funnel color: loyal core in red, other stages black.",
            "displayFolder": "Page 01 Base",
            "expression": [
              "",
              "IF ( SELECTEDVALUE ( dim_journey_stage[stage_sort] ) = 5, \"#D7192D\", \"#111111\" )"
            ],
            "lineageTag": "ed1a8e47-dc54-4dcd-a802-ace155e8f9dc"
          },
          {
            "name": "Title 01 Journey",
            "description": "Page 01 funnel title: repeat and regular rates among buyers.",
            "displayFolder": "Page 01 Base",
            "expression": [
              "VAR Buyers = [Purchasing Customers]",
              "VAR CameBack = DIVIDE ( CALCULATE ( [Customers], rpt_customer[orders] >= 2 ), Buyers )",
              "VAR Regulars = DIVIDE ( CALCULATE ( [Customers], rpt_customer[orders] >= 5 ), Buyers )",
              "RETURN",
              "    FORMAT ( CameBack, \"0%\" ) & \" ordered twice; \" & FORMAT ( Regulars, \"0%\" ) & \" ordered 5 or more times\""
            ],
            "lineageTag": "35029597-c6b4-4173-adf0-edd1fa117a9a"
          },
          {
            "name": "Title 01 Channel Mix",
            "description": "Page 01 channel mix title: omnichannel share by sign-up period (tenure effect).",
            "displayFolder": "Page 01 Base",
            "expression": [
              "VAR CovidStart = DATE ( 2020, 3, 1 )",
              "VAR PreStart = EDATE ( CovidStart, -12 )",
              "VAR PreBoth = CALCULATE ( [Customers], rpt_customer[channel_preference] = \"Omnichannel\", rpt_customer[cohort_month] >= PreStart, rpt_customer[cohort_month] < CovidStart )",
              "VAR PreBuyers = CALCULATE ( [Customers], rpt_customer[has_purchased] = TRUE (), rpt_customer[cohort_month] >= PreStart, rpt_customer[cohort_month] < CovidStart )",
              "VAR CovidBoth = CALCULATE ( [Customers], rpt_customer[channel_preference] = \"Omnichannel\", rpt_customer[cohort_month] >= CovidStart )",
              "VAR CovidBuyers = CALCULATE ( [Customers], rpt_customer[has_purchased] = TRUE (), rpt_customer[cohort_month] >= CovidStart )",
              "RETURN",
              "    FORMAT ( DIVIDE ( PreBoth, PreBuyers ), \"0%\" ) & \" of customers who joined before COVID shop online and in stores; only \"",
              "        & FORMAT ( DIVIDE ( CovidBoth, CovidBuyers ), \"0%\" ) & \" of COVID joiners do\""
            ],
            "lineageTag": "14fcccb1-1790-4cdc-b40b-9be2417f7b36"
          },
          {
            "name": "Title 01 Age Profile",
            "description": "Page 01 age profile title: young and older peaks, or a single peak when one band is selected.",
            "displayFolder": "Page 01 Base",
            "expression": [
              "VAR AgeTable =",
              "    ADDCOLUMNS ( FILTER ( VALUES ( rpt_customer[age] ), NOT ISBLANK ( rpt_customer[age] ) ), \"@Customers\", CALCULATE ( [Customers] ) )",
              "VAR YoungPeak = MAXX ( TOPN ( 1, FILTER ( AgeTable, rpt_customer[age] < 40 ), [@Customers], DESC ), rpt_customer[age] )",
              "VAR OlderPeak = MAXX ( TOPN ( 1, FILTER ( AgeTable, rpt_customer[age] >= 40 ), [@Customers], DESC ), rpt_customer[age] )",
              "VAR OverallPeak = MAXX ( TOPN ( 1, AgeTable, [@Customers], DESC ), rpt_customer[age] )",
              "RETURN",
              "    IF (",
              "        NOT ISBLANK ( YoungPeak ) && NOT ISBLANK ( OlderPeak ),",
              "        \"Customer ages peak twice: around \" & YoungPeak & \" and around \" & OlderPeak,",
              "        \"Most customers are around \" & OverallPeak",
              "    )"
            ],
            "lineageTag": "c3349f8d-53ad-41a9-860d-f4de4f20b7ee"
          },
          {
            "name": "Repeat Buyer Share %",
            "description": "Share of buyers with 2 or more orders.",
            "displayFolder": "Page 02 Return",
            "expression": "DIVIDE ( CALCULATE ( [Customers], rpt_customer[orders] >= 2 ), [Purchasing Customers] )",
            "formatString": "0.0%",
            "lineageTag": "a752ae69-9fbd-49bd-86f5-89431e5424fc"
          },
          {
            "name": "Orders per Buyer",
            "description": "Average lifetime orders per buyer.",
            "displayFolder": "Page 02 Return",
            "expression": "DIVIDE ( SUM ( rpt_customer[orders] ), [Purchasing Customers] )",
            "formatString": "#,0.0",
            "lineageTag": "852ad0aa-8af3-42f3-a43d-06d68cddcca8"
          },
          {
            "name": "Median Orders per Buyer",
            "description": "Median lifetime orders among buyers.",
            "displayFolder": "Page 02 Return",
            "expression": "CALCULATE ( MEDIAN ( rpt_customer[orders] ), rpt_customer[has_purchased] = TRUE () )",
            "formatString": "#,0",
            "lineageTag": "f838a899-3f71-4957-a35a-4a2efbd46173"
          },
          {
            "name": "Loyal 10+ Share %",
            "description": "Share of buyers with 10 or more orders.",
            "displayFolder": "Page 02 Return",
            "expression": "DIVIDE ( CALCULATE ( [Customers], rpt_customer[orders] >= 10 ), [Purchasing Customers] )",
            "formatString": "0.0%",
            "lineageTag": "ed9776bc-5256-4da4-a1c8-05cefdeea0a5"
          },
          {
            "name": "Month 1 Retention COVID Joiners %",
            "description": "Month-1 retention for customers who joined from Mar 2020.",
            "displayFolder": "Page 02 Return",
            "expression": "CALCULATE ( [Month 1 Retention %], cohort_retention[cohort_month] >= DATE ( 2020, 3, 1 ) )",
            "formatString": "0.0%",
            "lineageTag": "63b868db-d7fb-44a0-96db-8ec89b84b9f9"
          },
          {
            "name": "Month 1 Retention Pre-COVID Joiners %",
            "description": "Month-1 retention for Standard cohorts that joined Mar 2019 to Feb 2020.",
            "displayFolder": "Page 02 Return",
            "expression": "CALCULATE ( [Month 1 Retention %], cohort_retention[cohort_month] < DATE ( 2020, 3, 1 ) )",
            "formatString": "0.0%",
            "lineageTag": "810496cd-2623-4ef6-919c-5e62ccba5728"
          },
          {
            "name": "Buyer Share %",
            "description": "Share of buyers in the selected order-count bucket.",
            "displayFolder": "Page 02 Return",
            "expression": [
              "DIVIDE (",
              "    [Customers],",
              "    CALCULATE (",
              "        [Customers],",
              "        REMOVEFILTERS ( rpt_customer[orders_bucket], rpt_customer[orders_bucket_sort] ),",
              "        rpt_customer[has_purchased] = TRUE ()",
              "    )",
              ")"
            ],
            "formatString": "0%",
            "lineageTag": "3980c013-d91b-45e6-80e5-f81ee627404e"
          },
          {
            "name": "Ref Month 1 Retention",
            "description": "Rail comparison line for month-1 retention.",
            "displayFolder": "Page 02 Return",
            "expression": "\"After 3 months: \" & FORMAT ( [Month 3 Retention %], \"0%\" ) & \"  ·  after 12: \" & FORMAT ( [Month 12 Retention %], \"0%\" )",
            "lineageTag": "d1558f07-c7b3-4777-b141-1612471faf14"
          },
          {
            "name": "Ref Repeat Buyers",
            "description": "Rail comparison line for repeat buyers.",
            "displayFolder": "Page 02 Return",
            "expression": "\"A typical customer orders \" & FORMAT ( [Median Orders per Buyer], \"0\" ) & \" times\"",
            "lineageTag": "24e47f3c-ff1a-4bbf-8eb8-47b7031d667c"
          },
          {
            "name": "Ref COVID Joiners",
            "description": "Rail comparison line for COVID joiners' month-1 retention.",
            "displayFolder": "Page 02 Return",
            "expression": "\"vs \" & FORMAT ( [Month 1 Retention Pre-COVID Joiners %], \"0%\" ) & \" for those who joined before COVID\"",
            "lineageTag": "8216a982-6e27-4e40-acb0-a11469e59961"
          },
          {
            "name": "Ref Orders per Buyer",
            "description": "Rail comparison line for orders per buyer.",
            "displayFolder": "Page 02 Return",
            "expression": "FORMAT ( [Loyal 10+ Share %], \"0%\" ) & \" ordered 10 or more times\"",
            "lineageTag": "f363530f-593c-44ad-8142-160c948606aa"
          },
          {
            "name": "Headline 02",
            "description": "Page 02 headline: month-1 and month-6 retention for the customers in scope.",
            "displayFolder": "Page 02 Return",
            "expression": [
              "[Scope Label] & \": \" & FORMAT ( [Month 1 Retention %], \"0%\" ) & \" come back a month after joining; \"",
              "    & FORMAT ( [Month 6 Retention %], \"0%\" ) & \" after six months\""
            ],
            "lineageTag": "6de23aac-2ee1-483e-a85e-d559b7c24946"
          },
          {
            "name": "Subline 02",
            "description": "Page 02 supporting line.",
            "displayFolder": "Page 02 Return",
            "expression": "FORMAT ( [Repeat Buyer Share %], \"0%\" ) & \" of customers came back at least once  ·  each row is the group of customers who joined that month  ·  joiners from Mar 2019\"",
            "lineageTag": "92ee275d-499e-4a46-bfdf-d6363b094e5f"
          },
          {
            "name": "Title 02 Heatmap",
            "description": "Page 02 heatmap title: weakest and strongest month-1 retention by joining month.",
            "displayFolder": "Page 02 Return",
            "expression": [
              "VAR CohortTable =",
              "    FILTER (",
              "        ADDCOLUMNS (",
              "            CALCULATETABLE ( VALUES ( cohort_retention[cohort_month] ), cohort_retention[cohort_type] = \"Standard\" ),",
              "            \"@M1\", [Month 1 Retention %]",
              "        ),",
              "        NOT ISBLANK ( [@M1] )",
              "    )",
              "VAR BestRow = TOPN ( 1, CohortTable, [@M1], DESC )",
              "VAR WorstRow = TOPN ( 1, CohortTable, [@M1], ASC )",
              "RETURN",
              "    \"Customers who joined in \" & FORMAT ( MAXX ( BestRow, cohort_retention[cohort_month] ), \"mmm yyyy\" )",
              "        & \" came back most the next month (\" & FORMAT ( MAXX ( BestRow, [@M1] ), \"0%\" ) & \"); \"",
              "        & FORMAT ( MINX ( WorstRow, cohort_retention[cohort_month] ), \"mmm yyyy\" ) & \" joiners least (\"",
              "        & FORMAT ( MINX ( WorstRow, [@M1] ), \"0%\" ) & \")\""
            ],
            "lineageTag": "096bf01a-4ab3-4715-b7f0-24c80d20d05b"
          },
          {
            "name": "Title 02 Curves",
            "description": "Page 02 retention curve title: month-3 retention, COVID vs pre-COVID joiners.",
            "displayFolder": "Page 02 Return",
            "expression": [
              "VAR PreRate = CALCULATE ( [Month 3 Retention %], cohort_retention[cohort_month] < DATE ( 2020, 3, 1 ) )",
              "VAR CovidRate = CALCULATE ( [Month 3 Retention %], cohort_retention[cohort_month] >= DATE ( 2020, 3, 1 ) )",
              "RETURN",
              "    \"3 months in, \" & FORMAT ( CovidRate, \"0%\" ) & \" of COVID joiners still buy (\" & FORMAT ( PreRate, \"0%\" ) & \" before)\""
            ],
            "lineageTag": "e50f0c5e-fee7-416b-9021-03ed1209d856"
          },
          {
            "name": "Title 02 Frequency",
            "description": "Page 02 order frequency title.",
            "displayFolder": "Page 02 Return",
            "expression": [
              "VAR OneTime = DIVIDE ( CALCULATE ( [Customers], rpt_customer[orders] = 1 ), [Purchasing Customers] )",
              "RETURN",
              "    FORMAT ( OneTime, \"0%\" ) & \" bought only once; a typical customer ordered \" & FORMAT ( [Median Orders per Buyer], \"0\" ) & \" times\""
            ],
            "lineageTag": "69fe80a0-a125-4948-854b-f5396bdeea75"
          },
          {
            "name": "Color 02 Frequency",
            "description": "Order frequency column color: one-time buyers in red.",
            "displayFolder": "Page 02 Return",
            "expression": "IF ( SELECTEDVALUE ( rpt_customer[orders_bucket] ) = \"1\", \"#D7192D\", \"#111111\" )",
            "lineageTag": "16a77498-cca0-4e7e-ae8b-a5a0bcebef3f"
          },
          {
            "name": "Color 02 Heat Fill",
            "description": "Heatmap cell fill: denim shades relative to the highest visible retention.",
            "displayFolder": "Page 02 Return",
            "expression": [
              "VAR CellRate = [Cohort Retention %]",
              "VAR MaxRate =",
              "    MAXX (",
              "        ALLSELECTED ( cohort_retention[cohort_month], cohort_retention[months_since_first_purchase] ),",
              "        [Cohort Retention %]",
              "    )",
              "VAR Ratio = DIVIDE ( CellRate, MaxRate )",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( CellRate ), \"#FFFFFF\",",
              "        Ratio >= 0.85, \"#1F2E3B\",",
              "        Ratio >= 0.70, \"#3E5C76\",",
              "        Ratio >= 0.55, \"#7D97AD\",",
              "        Ratio >= 0.40, \"#B9C7D3\",",
              "        Ratio >= 0.25, \"#DCE4EA\",",
              "        \"#F2F5F7\"",
              "    )"
            ],
            "lineageTag": "df079a74-d215-4112-8c49-7ac6d9b10b87"
          },
          {
            "name": "Color 02 Heat Font",
            "description": "Heatmap cell font: white on dark cells.",
            "displayFolder": "Page 02 Return",
            "expression": [
              "VAR CellRate = [Cohort Retention %]",
              "VAR MaxRate =",
              "    MAXX (",
              "        ALLSELECTED ( cohort_retention[cohort_month], cohort_retention[months_since_first_purchase] ),",
              "        [Cohort Retention %]",
              "    )",
              "VAR Ratio = DIVIDE ( CellRate, MaxRate )",
              "RETURN",
              "    IF ( Ratio >= 0.55, \"#FFFFFF\", \"#111111\" )"
            ],
            "lineageTag": "38a07a6c-bc9c-4223-aeb1-0c697d36dc85"
          },
          {
            "name": "Cohort Retention Cell %",
            "description": "Cohort retention shown in the heatmap, whole percent.",
            "displayFolder": "Page 02 Return",
            "expression": "[Cohort Retention %]",
            "formatString": "0%",
            "lineageTag": "55c25da3-5188-4d78-91c5-9907098818a8"
          },
          {
            "name": "Champion Customer Share %",
            "description": "Champions as a share of buyers.",
            "displayFolder": "Page 03 Value",
            "expression": "DIVIDE ( CALCULATE ( [Customers], rpt_customer[rfm_segment] = \"Champions\" ), [Purchasing Customers] )",
            "formatString": "0.0%",
            "lineageTag": "2efceda5-8012-4ff9-a608-d7ad64b0521f"
          },
          {
            "name": "Champion Spend Share %",
            "description": "Champions' share of lifetime spend.",
            "displayFolder": "Page 03 Value",
            "expression": "DIVIDE ( CALCULATE ( [Lifetime Spend], rpt_customer[rfm_segment] = \"Champions\" ), [Lifetime Spend] )",
            "formatString": "0.0%",
            "lineageTag": "f0da9d8f-8bab-48d9-be4d-b7b8bcbb547e"
          },
          {
            "name": "Top 20% Spend Share %",
            "description": "Share of spend from buyers in the top 20 spend percentiles.",
            "displayFolder": "Page 03 Value",
            "expression": "DIVIDE ( CALCULATE ( [Lifetime Spend], rpt_customer[spend_percentile] <= 20 ), [Lifetime Spend] )",
            "formatString": "0.0%",
            "lineageTag": "a4b810f0-24ce-4149-944e-c0971b8d576d"
          },
          {
            "name": "Top 1% Spend Share %",
            "description": "Share of spend from buyers in the top spend percentile.",
            "displayFolder": "Page 03 Value",
            "expression": "DIVIDE ( CALCULATE ( [Lifetime Spend], rpt_customer[spend_percentile] <= 1 ), [Lifetime Spend] )",
            "formatString": "0.0%",
            "lineageTag": "9927be57-f48c-4886-81b4-daa1474ddee4"
          },
          {
            "name": "Bottom 50% Spend Share %",
            "description": "Share of spend from the lower half of buyers by spend.",
            "displayFolder": "Page 03 Value",
            "expression": "DIVIDE ( CALCULATE ( [Lifetime Spend], rpt_customer[spend_percentile] > 50 ), [Lifetime Spend] )",
            "formatString": "0.0%",
            "lineageTag": "a9694fa1-78a0-4ae1-8c1e-6a31ef644867"
          },
          {
            "name": "Spend per Buyer",
            "description": "Lifetime scaled spend per buyer (relative, not real currency).",
            "displayFolder": "Page 03 Value",
            "expression": "DIVIDE ( [Lifetime Spend], [Purchasing Customers] )",
            "formatString": "0.00",
            "lineageTag": "04413474-7171-4c3a-a967-9744074fe04a"
          },
          {
            "name": "Champion Spend Multiple",
            "description": "Champions' spend per buyer relative to all buyers.",
            "displayFolder": "Page 03 Value",
            "expression": [
              "VAR ChampSpend = CALCULATE ( [Lifetime Spend], rpt_customer[rfm_segment] = \"Champions\" )",
              "VAR ChampBuyers = CALCULATE ( [Customers], rpt_customer[rfm_segment] = \"Champions\" )",
              "RETURN",
              "    DIVIDE ( DIVIDE ( ChampSpend, ChampBuyers ), [Spend per Buyer] )"
            ],
            "formatString": "0.0",
            "lineageTag": "2ab1ad62-e97e-4ff1-b7d7-0cc4c0885903"
          },
          {
            "name": "Lapsing Customer Share %",
            "description": "Buyers in At risk, Hibernating or Lost segments.",
            "displayFolder": "Page 03 Value",
            "expression": "DIVIDE ( CALCULATE ( [Customers], rpt_customer[rfm_segment] IN { \"At risk\", \"Hibernating\", \"Lost\" } ), [Purchasing Customers] )",
            "formatString": "0.0%",
            "lineageTag": "41ce7a9d-ebb0-41f1-a5fb-0620e3f50656"
          },
          {
            "name": "Lapsing Spend Share %",
            "description": "Lifetime spend share held by At risk, Hibernating or Lost buyers.",
            "displayFolder": "Page 03 Value",
            "expression": "DIVIDE ( CALCULATE ( [Lifetime Spend], rpt_customer[rfm_segment] IN { \"At risk\", \"Hibernating\", \"Lost\" } ), [Lifetime Spend] )",
            "formatString": "0.0%",
            "lineageTag": "af302749-08ef-4927-ab24-67cd4190aef8"
          },
          {
            "name": "Ref Champion Spend",
            "description": "Rail line.",
            "displayFolder": "Page 03 Value",
            "expression": "\"From just \" & FORMAT ( [Champion Customer Share %], \"0%\" ) & \" of customers\"",
            "lineageTag": "820ab30d-410e-4ef1-bb57-f56e97e07bd7"
          },
          {
            "name": "Ref Top 20 Spend",
            "description": "Rail line.",
            "displayFolder": "Page 03 Value",
            "expression": "\"The top 1% alone: \" & FORMAT ( [Top 1% Spend Share %], \"0%\" )",
            "lineageTag": "362fda3e-ad8f-4b79-80eb-260f45094872"
          },
          {
            "name": "Ref Spend per Buyer",
            "description": "Rail line.",
            "displayFolder": "Page 03 Value",
            "expression": "\"Best customers spend \" & FORMAT ( [Champion Spend Multiple], \"0.0\" ) & \" times the average\"",
            "lineageTag": "ed0faefb-006c-4790-86b9-6983b9f03cce"
          },
          {
            "name": "Ref Lapsing",
            "description": "Rail line.",
            "displayFolder": "Page 03 Value",
            "expression": "\"They made \" & FORMAT ( [Lapsing Spend Share %], \"0%\" ) & \" of all past sales\"",
            "lineageTag": "9749afea-f510-485a-b600-aed9225e74a5"
          },
          {
            "name": "Headline 03",
            "description": "Page 03 headline.",
            "displayFolder": "Page 03 Value",
            "expression": [
              "[Scope Label] & \": \" & FORMAT ( [Champion Customer Share %], \"0%\" ) & \" are best customers and bring in \"",
              "    & FORMAT ( [Champion Spend Share %], \"0%\" ) & \" of sales\""
            ],
            "lineageTag": "ebf727ba-ea31-4f75-940c-949554839229"
          },
          {
            "name": "Subline 03",
            "description": "Page 03 supporting line.",
            "displayFolder": "Page 03 Value",
            "expression": [
              "VAR AsOf = CALCULATE ( MAX ( dim_date[date] ), REMOVEFILTERS () )",
              "RETURN",
              "    \"Customers are grouped by how recently, how often and how much they buy, as of \" & FORMAT ( AsOf, \"d mmm yyyy\" )",
              "        & \"  ·  best customers = the 'Champions' group  ·  prices scaled by H&M\""
            ],
            "lineageTag": "59ce8f16-ac67-4fec-b8d7-9187f9e6b884"
          },
          {
            "name": "Cumulative Spend Share %",
            "description": "Share of spend from buyers at or above the current spend percentile.",
            "displayFolder": "Page 03 Value",
            "expression": [
              "VAR CurrentPercentile = MAX ( rpt_customer[spend_percentile] )",
              "RETURN",
              "    DIVIDE (",
              "        CALCULATE ( [Lifetime Spend], rpt_customer[spend_percentile] <= CurrentPercentile ),",
              "        CALCULATE ( [Lifetime Spend], REMOVEFILTERS ( rpt_customer[spend_percentile] ) )",
              "    )"
            ],
            "formatString": "0%",
            "lineageTag": "7462becc-1872-4833-9502-b162c6c0a449"
          },
          {
            "name": "Equal Share Line %",
            "description": "Reference line: the spend share if every buyer spent the same.",
            "displayFolder": "Page 03 Value",
            "expression": "DIVIDE ( MAX ( rpt_customer[spend_percentile] ), 100 )",
            "formatString": "0%",
            "lineageTag": "18b4f64d-74a9-475d-a2e8-a675b8d85d0c"
          },
          {
            "name": "Title 03 Pareto",
            "description": "Page 03 Pareto title.",
            "displayFolder": "Page 03 Value",
            "expression": [
              "\"The top 20% of customers bring in \" & FORMAT ( [Top 20% Spend Share %], \"0%\" ) & \" of sales; the bottom half, just \"",
              "    & FORMAT ( [Bottom 50% Spend Share %], \"0%\" )"
            ],
            "lineageTag": "51e97423-ca54-4085-bb84-c67becd9354c"
          },
          {
            "name": "Grid Customer Share %",
            "description": "Share of buyers in the RFM grid cell.",
            "displayFolder": "Page 03 Value",
            "expression": [
              "DIVIDE (",
              "    [Customers],",
              "    CALCULATE ( [Purchasing Customers], REMOVEFILTERS ( rpt_customer[r_score], rpt_customer[fm_score] ) )",
              ")"
            ],
            "formatString": "0%",
            "lineageTag": "908504b3-4575-403c-aefc-a0754166b363"
          },
          {
            "name": "Color 03 Grid Fill",
            "description": "RFM grid fill: camel shades by spend per buyer, relative to the highest cell.",
            "displayFolder": "Page 03 Value",
            "expression": [
              "VAR CellSpend = [Spend per Buyer]",
              "VAR MaxSpend =",
              "    MAXX ( ALLSELECTED ( rpt_customer[r_score], rpt_customer[fm_score] ), [Spend per Buyer] )",
              "VAR Ratio = DIVIDE ( CellSpend, MaxSpend )",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( CellSpend ), \"#FFFFFF\",",
              "        Ratio >= 0.80, \"#5E4838\",",
              "        Ratio >= 0.55, \"#8C6E58\",",
              "        Ratio >= 0.35, \"#B8977E\",",
              "        Ratio >= 0.20, \"#D9C7B2\",",
              "        Ratio >= 0.10, \"#E9DDD1\",",
              "        \"#F6F1EC\"",
              "    )"
            ],
            "lineageTag": "12a254ee-3bea-45ff-8110-163f96f70100"
          },
          {
            "name": "Color 03 Grid Font",
            "description": "RFM grid font color.",
            "displayFolder": "Page 03 Value",
            "expression": [
              "VAR CellSpend = [Spend per Buyer]",
              "VAR MaxSpend =",
              "    MAXX ( ALLSELECTED ( rpt_customer[r_score], rpt_customer[fm_score] ), [Spend per Buyer] )",
              "VAR Ratio = DIVIDE ( CellSpend, MaxSpend )",
              "RETURN",
              "    IF ( Ratio >= 0.55, \"#FFFFFF\", \"#111111\" )"
            ],
            "lineageTag": "ed0b02af-03e8-4e5a-b7c6-f280057c93d0"
          },
          {
            "name": "Title 03 Grid",
            "description": "Page 03 RFM grid title.",
            "displayFolder": "Page 03 Value",
            "expression": [
              "VAR TopCell = CALCULATE ( [Spend per Buyer], rpt_customer[r_score] = 5, rpt_customer[fm_score] = 5 )",
              "VAR BottomCell = CALCULATE ( [Spend per Buyer], rpt_customer[r_score] = 1, rpt_customer[fm_score] = 1 )",
              "RETURN",
              "    \"Recent, frequent big spenders spend \" & FORMAT ( DIVIDE ( TopCell, BottomCell ), \"0\" )",
              "        & \" times more each than quiet one-off buyers\""
            ],
            "lineageTag": "641db6b1-779c-42c1-967c-654baeb63671"
          },
          {
            "name": "Title 03 Scatter",
            "description": "Page 03 segment scatter title.",
            "displayFolder": "Page 03 Value",
            "expression": [
              "VAR ChampDays = CALCULATE ( [Avg Days Since Last Purchase], rpt_customer[rfm_segment] = \"Champions\" )",
              "VAR LostDays = CALCULATE ( [Avg Days Since Last Purchase], rpt_customer[rfm_segment] = \"Lost\" )",
              "RETURN",
              "    \"Best customers bought \" & FORMAT ( ChampDays, \"0\" ) & \" days ago; lost ones, \" & FORMAT ( LostDays / 30.4, \"0\" ) & \" months\""
            ],
            "lineageTag": "29a19e4b-db9f-4513-b66f-c4a29164f602"
          },
          {
            "name": "Title 03 Table",
            "description": "Page 03 segment table title.",
            "displayFolder": "Page 03 Value",
            "expression": [
              "VAR AtRiskBuyers = DIVIDE ( CALCULATE ( [Customers], rpt_customer[rfm_segment] = \"At risk\" ), [Purchasing Customers] )",
              "RETURN",
              "    FORMAT ( AtRiskBuyers, \"0%\" ) & \" are 'At risk': once regular, now gone quiet\""
            ],
            "lineageTag": "3dff4c9f-75c8-42be-b01d-0b43b43fcf66"
          },
          {
            "name": "Churn Model Accuracy",
            "description": "Test-split accuracy (Jun 2020 cutoff) from ML.EVALUATE.",
            "displayFolder": "7 Model notes",
            "expression": "0.731",
            "formatString": "0.0%",
            "lineageTag": "bd467bfa-eaa8-482b-ba5a-5967e638d849"
          },
          {
            "name": "Churn Model Naive Accuracy",
            "description": "Accuracy from always guessing the majority outcome on the test split.",
            "displayFolder": "7 Model notes",
            "expression": [
              "VAR Rate =",
              "    CALCULATE ( [Observed Churn Rate %], rpt_churn_drivers[data_split] = \"test\", REMOVEFILTERS ( dim_age_band ) )",
              "RETURN",
              "    MAX ( Rate, 1 - Rate )"
            ],
            "formatString": "0.0%",
            "lineageTag": "c67eee79-f9c3-4a16-a39a-9d7f384b89bf"
          },
          {
            "name": "Observed Churn Latest %",
            "description": "Share of active buyers at the Jun 2020 cutoff who did not buy in the next 90 days.",
            "displayFolder": "Page 04 Risk",
            "expression": "CALCULATE ( [Observed Churn Rate %], rpt_churn_drivers[data_split] = \"test\" )",
            "formatString": "0.0%",
            "lineageTag": "1c2f6c9d-0cc0-4d79-912b-5878ab3d008e"
          },
          {
            "name": "Observed Churn Pre-COVID %",
            "description": "Observed churn at the Dec 2019 cutoff.",
            "displayFolder": "Page 04 Risk",
            "expression": "CALCULATE ( [Observed Churn Rate %], rpt_churn_drivers[cutoff_date] = DATE ( 2019, 12, 1 ) )",
            "formatString": "0.0%",
            "lineageTag": "c879b408-e698-486e-95fa-9e9224bb78f6"
          },
          {
            "name": "Observed Churn Lockdown %",
            "description": "Observed churn at the Mar 2020 cutoff (COVID lockdown).",
            "displayFolder": "Page 04 Risk",
            "expression": "CALCULATE ( [Observed Churn Rate %], rpt_churn_drivers[data_split] = \"covid_lockdown\" )",
            "formatString": "0.0%",
            "lineageTag": "f21c51f0-dc2c-4766-b989-af572a42db49"
          },
          {
            "name": "Pre-member Churn Latest %",
            "description": "Observed churn at the Jun 2020 cutoff for PRE-CREATE (not yet full) club members.",
            "displayFolder": "Page 04 Risk",
            "expression": "CALCULATE ( [Observed Churn Rate %], rpt_churn_drivers[data_split] = \"test\", rpt_churn_drivers[club_member_status] = \"PRE-CREATE\" )",
            "formatString": "0.0%",
            "lineageTag": "0443fecb-eae6-4725-9d36-9dfdbb8e2567"
          },
          {
            "name": "Active Member Churn Latest %",
            "description": "Observed churn at the Jun 2020 cutoff for ACTIVE club members.",
            "displayFolder": "Page 04 Risk",
            "expression": "CALCULATE ( [Observed Churn Rate %], rpt_churn_drivers[data_split] = \"test\", rpt_churn_drivers[club_member_status] = \"ACTIVE\" )",
            "formatString": "0.0%",
            "lineageTag": "ede21484-b79d-4df3-9236-6df915d83403"
          },
          {
            "name": "Left Club Churn Latest %",
            "description": "Observed churn at the Jun 2020 cutoff for buyers who left the club.",
            "displayFolder": "Page 04 Risk",
            "expression": "CALCULATE ( [Observed Churn Rate %], rpt_churn_drivers[data_split] = \"test\", rpt_churn_drivers[club_member_status] = \"LEFT CLUB\" )",
            "formatString": "0.0%",
            "lineageTag": "2d1ecced-72fb-46c3-8e1e-d39c0b16e885"
          },
          {
            "name": "Low Risk Share %",
            "description": "Scored buyers below 40% churn probability.",
            "displayFolder": "Page 04 Risk",
            "expression": "DIVIDE ( CALCULATE ( [Customers], rpt_customer[churn_risk_band] = \"Low\" ), [Scored Customers] )",
            "formatString": "0.0%",
            "lineageTag": "12fe3729-c1e0-4712-b40d-6f6b2f5f1ff1"
          },
          {
            "name": "Risk Bucket Share %",
            "description": "Share of scored buyers in the churn probability bucket.",
            "displayFolder": "Page 04 Risk",
            "expression": [
              "DIVIDE (",
              "    [Scored Customers],",
              "    CALCULATE ( [Scored Customers], REMOVEFILTERS ( rpt_customer[churn_bucket], rpt_customer[churn_bucket_sort] ) )",
              ")"
            ],
            "formatString": "0%",
            "lineageTag": "2250e427-01f4-4774-bff6-ad5ff40fc42c"
          },
          {
            "name": "Ref Avg Churn Probability",
            "description": "Rail line.",
            "displayFolder": "Page 04 Risk",
            "expression": "\"About \" & FORMAT ( [Expected Churners] / 1000, \"#,0\" ) & \"K of \" & FORMAT ( [Scored Customers] / 1000, \"#,0\" ) & \"K recent customers\"",
            "lineageTag": "aa15e3a6-7005-482f-8baf-ee7009f02e11"
          },
          {
            "name": "Ref High Risk",
            "description": "Rail line.",
            "displayFolder": "Page 04 Risk",
            "expression": "FORMAT ( [High Risk Customers] / 1000, \"#,0\" ) & \"K customers at 70% or higher\"",
            "lineageTag": "1f739aee-70ba-4c08-8be4-467ffe189726"
          },
          {
            "name": "Ref Observed Churn",
            "description": "Rail line.",
            "displayFolder": "Page 04 Risk",
            "expression": "\"Dec 2019: \" & FORMAT ( [Observed Churn Pre-COVID %], \"0%\" ) & \"  ·  Mar 2020 lockdown: \" & FORMAT ( [Observed Churn Lockdown %], \"0%\" )",
            "lineageTag": "67bdd0cc-809c-4a4c-881a-32dd02e931a5"
          },
          {
            "name": "Ref Pre-member Churn",
            "description": "Rail line.",
            "displayFolder": "Page 04 Risk",
            "expression": "\"vs \" & FORMAT ( [Active Member Churn Latest %], \"0%\" ) & \" for active members\"",
            "lineageTag": "ae379388-5c6f-40d6-b7d2-1321c641b766"
          },
          {
            "name": "Headline 04",
            "description": "Page 04 headline.",
            "displayFolder": "Page 04 Risk",
            "expression": "[Scope Label] & \": \" & FORMAT ( [Avg Churn Probability], \"0%\" ) & \" are likely to stop buying in the next 3 months\"",
            "lineageTag": "141cd17d-918e-43bf-b9dd-cfc444b228af"
          },
          {
            "name": "Subline 04",
            "description": "Page 04 supporting line.",
            "displayFolder": "Page 04 Risk",
            "expression": [
              "VAR AsOf = CALCULATE ( MAX ( dim_date[date] ), REMOVEFILTERS () )",
              "RETURN",
              "    \"Stopped buying = no purchase for 3 months  ·  in real data, \" & FORMAT ( [Observed Churn Latest %], \"0%\" )",
              "        & \" of customers active in Jun 2020 stopped  ·  predictions as of \" & FORMAT ( AsOf, \"d mmm yyyy\" )"
            ],
            "lineageTag": "0c247f31-52d8-41f0-8ea6-318f20cd2806"
          },
          {
            "name": "Title 04 Heat",
            "description": "Page 04 heat matrix title.",
            "displayFolder": "Page 04 Risk",
            "expression": [
              "VAR OldestRecency = CALCULATE ( MAX ( rpt_churn_drivers[recency_sort] ), REMOVEFILTERS () )",
              "VAR NewestRecency = CALCULATE ( MIN ( rpt_churn_drivers[recency_sort] ), REMOVEFILTERS () )",
              "VAR FewestOrders = CALCULATE ( MIN ( rpt_churn_drivers[orders_sort] ), REMOVEFILTERS () )",
              "VAR MostOrders = CALCULATE ( MAX ( rpt_churn_drivers[orders_sort] ), REMOVEFILTERS () )",
              "VAR ColdRate =",
              "    CALCULATE ( [Observed Churn Rate %], rpt_churn_drivers[data_split] = \"test\",",
              "        rpt_churn_drivers[recency_sort] = OldestRecency, rpt_churn_drivers[orders_sort] = FewestOrders )",
              "VAR WarmRate =",
              "    CALCULATE ( [Observed Churn Rate %], rpt_churn_drivers[data_split] = \"test\",",
              "        rpt_churn_drivers[recency_sort] = NewestRecency, rpt_churn_drivers[orders_sort] = MostOrders )",
              "VAR ColdRecency = CALCULATE ( MAX ( rpt_churn_drivers[recency_label] ), REMOVEFILTERS (), rpt_churn_drivers[recency_sort] = OldestRecency )",
              "VAR WarmRecency = CALCULATE ( MAX ( rpt_churn_drivers[recency_label] ), REMOVEFILTERS (), rpt_churn_drivers[recency_sort] = NewestRecency )",
              "VAR FewLabel = CALCULATE ( MAX ( rpt_churn_drivers[orders_label] ), REMOVEFILTERS (), rpt_churn_drivers[orders_sort] = FewestOrders )",
              "VAR ManyLabel = CALCULATE ( MAX ( rpt_churn_drivers[orders_label] ), REMOVEFILTERS (), rpt_churn_drivers[orders_sort] = MostOrders )",
              "RETURN",
              "    FORMAT ( ColdRate, \"0%\" ) & \" stopped buying (\" & FewLabel & \", last seen \" & ColdRecency & \" ago) vs \"",
              "        & FORMAT ( WarmRate, \"0%\" ) & \" (\" & ManyLabel & \", \" & WarmRecency & \")\""
            ],
            "lineageTag": "652bba04-66a9-4fb2-b347-443b20daab5a"
          },
          {
            "name": "Color 04 Heat Fill",
            "description": "Churn heat fill: red shades relative to the highest visible lapse rate.",
            "displayFolder": "Page 04 Risk",
            "expression": [
              "VAR CellRate = [Observed Churn Rate %]",
              "VAR MaxRate =",
              "    MAXX (",
              "        ALLSELECTED (",
              "            rpt_churn_drivers[recency_label], rpt_churn_drivers[recency_sort],",
              "            rpt_churn_drivers[orders_label], rpt_churn_drivers[orders_sort]",
              "        ),",
              "        [Observed Churn Rate %]",
              "    )",
              "VAR Ratio = DIVIDE ( CellRate, MaxRate )",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( CellRate ), \"#FFFFFF\",",
              "        Ratio >= 0.85, \"#7A0E19\",",
              "        Ratio >= 0.70, \"#A8121F\",",
              "        Ratio >= 0.55, \"#D7192D\",",
              "        Ratio >= 0.40, \"#E89AA3\",",
              "        Ratio >= 0.25, \"#F3C9CE\",",
              "        \"#FBEBED\"",
              "    )"
            ],
            "lineageTag": "116e5274-8aa8-4afb-8fd3-065727907c4e"
          },
          {
            "name": "Color 04 Heat Font",
            "description": "Churn heat font color.",
            "displayFolder": "Page 04 Risk",
            "expression": [
              "VAR CellRate = [Observed Churn Rate %]",
              "VAR MaxRate =",
              "    MAXX (",
              "        ALLSELECTED (",
              "            rpt_churn_drivers[recency_label], rpt_churn_drivers[recency_sort],",
              "            rpt_churn_drivers[orders_label], rpt_churn_drivers[orders_sort]",
              "        ),",
              "        [Observed Churn Rate %]",
              "    )",
              "VAR Ratio = DIVIDE ( CellRate, MaxRate )",
              "RETURN",
              "    IF ( Ratio >= 0.55, \"#FFFFFF\", \"#111111\" )"
            ],
            "lineageTag": "35238c64-d353-419b-910d-24d9775bcc3d"
          },
          {
            "name": "Title 04 Club",
            "description": "Page 04 club status title.",
            "displayFolder": "Page 04 Risk",
            "expression": "FORMAT ( [Pre-member Churn Latest %], \"0%\" ) & \" of pending members stopped vs \" & FORMAT ( [Active Member Churn Latest %], \"0%\" ) & \" of active ones\"",
            "lineageTag": "e4291250-08ee-4620-8deb-053b41823098"
          },
          {
            "name": "Title 04 Risk",
            "description": "Page 04 risk distribution title.",
            "displayFolder": "Page 04 Risk",
            "expression": [
              "FORMAT ( [High Risk Customers] / 1000, \"#,0\" ) & \"K customers have a 70% or higher chance of stopping; \"",
              "    & FORMAT ( [Low Risk Share %], \"0%\" ) & \" are under 40%\""
            ],
            "lineageTag": "6c7cafbd-b5ad-4631-a69b-aa527a46caa0"
          },
          {
            "name": "Color 04 Risk",
            "description": "Risk bucket column color: high risk red, medium camel, low black.",
            "displayFolder": "Page 04 Risk",
            "expression": [
              "VAR Step = MAX ( rpt_customer[churn_bucket_sort] )",
              "RETURN",
              "    SWITCH ( TRUE (), Step >= 7, \"#D7192D\", Step >= 4, \"#B8977E\", \"#111111\" )"
            ],
            "lineageTag": "1d7b5d12-dbd5-46af-b6f4-d8655eee9f69"
          },
          {
            "name": "Title 04 Model",
            "description": "Page 04 model scorecard title.",
            "displayFolder": "Page 04 Risk",
            "expression": "FORMAT ( [Churn Model Accuracy], \"0%\" ) & \" right vs \" & FORMAT ( [Churn Model Naive Accuracy], \"0%\" ) & \" by guessing\"",
            "lineageTag": "93b11214-9989-487f-ae16-753e877b1cf5"
          },
          {
            "name": "Ref Model AUC",
            "description": "Scorecard line.",
            "displayFolder": "Page 04 Risk",
            "expression": "\"Picks the leaver over the stayer \" & FORMAT ( [Churn Model ROC AUC], \"0%\" ) & \" of the time\"",
            "lineageTag": "765abe79-f07a-4e6d-9d80-58af0a43afe7"
          },
          {
            "name": "Ref Model Precision",
            "description": "Scorecard line.",
            "displayFolder": "Page 04 Risk",
            "expression": "FORMAT ( [Churn Model Precision], \"0%\" ) & \" of flagged customers did stop\"",
            "lineageTag": "7c403f59-1a4f-4464-8925-94e130c4d03b"
          },
          {
            "name": "Ref Model Recall",
            "description": "Scorecard line.",
            "displayFolder": "Page 04 Risk",
            "expression": "\"Flags \" & FORMAT ( [Churn Model Recall] * 100, \"0\" ) & \" of every 100 who stop\"",
            "lineageTag": "387f4b8e-969f-41b7-bc29-1e8b22b4642a"
          },
          {
            "name": "Ref Model Accuracy",
            "description": "Scorecard line.",
            "displayFolder": "Page 04 Risk",
            "expression": "\"Guessing gets \" & FORMAT ( [Churn Model Naive Accuracy], \"0%\" )",
            "lineageTag": "3f1ea39e-d512-455b-a7bd-f25832bb9456"
          },
          {
            "name": "Title 04 Model Recall",
            "description": "Page 04 scorecard title, right half.",
            "displayFolder": "Page 04 Risk",
            "expression": "\"Finds \" & FORMAT ( [Churn Model Recall], \"0%\" ) & \" of those who stop\"",
            "lineageTag": "8ef38311-06bb-41ef-9b74-a2f3c6fc9b3a"
          },
          {
            "name": "Units Season Before",
            "description": "Units from Mar 1 to the last data day, one year before COVID.",
            "displayFolder": "Page 05 Basket",
            "expression": "CALCULATE ( [Units], dim_date[same_season_sort] = 1 )",
            "formatString": "#,0",
            "lineageTag": "d8c66f11-4f60-4202-8e7b-d2b2ff7d3aac"
          },
          {
            "name": "Units Season COVID",
            "description": "Units from Mar 1, 2020 to the last data day.",
            "displayFolder": "Page 05 Basket",
            "expression": "CALCULATE ( [Units], dim_date[same_season_sort] = 2 )",
            "formatString": "#,0",
            "lineageTag": "e8cd9ec8-904b-4c8f-b63b-76d1d5799164"
          },
          {
            "name": "Units Season YoY %",
            "description": "Same-season unit change, COVID vs the year before.",
            "displayFolder": "Page 05 Basket",
            "expression": "DIVIDE ( [Units Season COVID], [Units Season Before] ) - 1",
            "formatString": "+0%;-0%;0%",
            "lineageTag": "c2b6e564-cc34-46d1-8dbb-533625fb0428"
          },
          {
            "name": "Online Units Season YoY %",
            "description": "Same-season online unit change.",
            "displayFolder": "Page 05 Basket",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( [Units Season COVID], agg_sales_daily[channel] = \"Online\" ),",
              "    CALCULATE ( [Units Season Before], agg_sales_daily[channel] = \"Online\" )",
              ") - 1"
            ],
            "formatString": "+0%;-0%;0%",
            "lineageTag": "557327a0-3744-4f73-8140-6613fee147c5"
          },
          {
            "name": "Store Units Season YoY %",
            "description": "Same-season store unit change.",
            "displayFolder": "Page 05 Basket",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( [Units Season COVID], agg_sales_daily[channel] = \"Store\" ),",
              "    CALCULATE ( [Units Season Before], agg_sales_daily[channel] = \"Store\" )",
              ") - 1"
            ],
            "formatString": "+0%;-0%;0%",
            "lineageTag": "aedb2759-0297-4968-a9af-003eeb86cda4"
          },
          {
            "name": "Online Share Season Before %",
            "description": "Online share of units, same season one year before COVID.",
            "displayFolder": "Page 05 Basket",
            "expression": "CALCULATE ( [Online Unit Share %], dim_date[same_season_sort] = 1 )",
            "formatString": "0.0%",
            "lineageTag": "2973bcfd-f1ed-4564-8e20-efa9479db232"
          },
          {
            "name": "Online Share Season COVID %",
            "description": "Online share of units, COVID season.",
            "displayFolder": "Page 05 Basket",
            "expression": "CALCULATE ( [Online Unit Share %], dim_date[same_season_sort] = 2 )",
            "formatString": "0.0%",
            "lineageTag": "d1f8e9bc-b919-4ed9-89e3-5ac75be45e5f"
          },
          {
            "name": "Share Shift Pts",
            "description": "Change in unit share, COVID season vs the same season a year before, in percentage points.",
            "displayFolder": "Page 05 Basket",
            "expression": [
              "(",
              "    CALCULATE ( [Unit Share %], dim_date[same_season_sort] = 2 )",
              "        - CALCULATE ( [Unit Share %], dim_date[same_season_sort] = 1 )",
              ") * 100"
            ],
            "formatString": "+0.0\" pts\";-0.0\" pts\";0.0\" pts\"",
            "lineageTag": "0b8711e2-aec0-41a3-abb7-84ca01253ef5"
          },
          {
            "name": "Biggest Gain Pts",
            "description": "Largest same-season share gain across product groups.",
            "displayFolder": "Page 05 Basket",
            "expression": "MAXX ( VALUES ( agg_sales_daily[product_group_label] ), [Product Share Shift Pts] )",
            "formatString": "+0.0\" pts\";-0.0\" pts\";0.0\" pts\"",
            "lineageTag": "ba1f9c86-6d6f-4c94-87c0-b8b419879d5c"
          },
          {
            "name": "Biggest Gain Group",
            "description": "Product group with the largest same-season share gain.",
            "displayFolder": "Page 05 Basket",
            "expression": [
              "CONCATENATEX (",
              "    TOPN ( 1, VALUES ( agg_sales_daily[product_group_label] ), [Product Share Shift Pts], DESC ),",
              "    agg_sales_daily[product_group_label], \", \"",
              ")"
            ],
            "lineageTag": "5ce3269d-4e0c-4b15-bf3b-6cedbd8357e1"
          },
          {
            "name": "Biggest Loss Pts",
            "description": "Largest same-season share loss across product groups.",
            "displayFolder": "Page 05 Basket",
            "expression": "MINX ( VALUES ( agg_sales_daily[product_group_label] ), [Product Share Shift Pts] )",
            "formatString": "+0.0\" pts\";-0.0\" pts\";0.0\" pts\"",
            "lineageTag": "30c2ce70-57bd-4a9a-8bcc-cc19f2f9e8ac"
          },
          {
            "name": "Biggest Loss Group",
            "description": "Product group with the largest same-season share loss.",
            "displayFolder": "Page 05 Basket",
            "expression": [
              "CONCATENATEX (",
              "    TOPN ( 1, VALUES ( agg_sales_daily[product_group_label] ), [Product Share Shift Pts], ASC ),",
              "    agg_sales_daily[product_group_label], \", \"",
              ")"
            ],
            "lineageTag": "0443a5b8-2b8f-45c7-9378-a749f263d591"
          },
          {
            "name": "Top Group Share %",
            "description": "Unit share of the largest index group.",
            "displayFolder": "Page 05 Basket",
            "expression": [
              "VAR AllUnits = [Units]",
              "VAR TopGroup = TOPN ( 1, VALUES ( agg_sales_daily[index_group] ), [Units], DESC )",
              "RETURN",
              "    DIVIDE ( SUMX ( TopGroup, [Units] ), AllUnits )"
            ],
            "formatString": "0.0%",
            "lineageTag": "bba3f14f-1843-4553-bfca-32679e9e9c0a"
          },
          {
            "name": "Top Group Name",
            "description": "Largest index group by units.",
            "displayFolder": "Page 05 Basket",
            "expression": "CONCATENATEX ( TOPN ( 1, VALUES ( agg_sales_daily[index_group] ), [Units], DESC ), agg_sales_daily[index_group], \", \" )",
            "lineageTag": "fd612b72-04bd-499a-9ab9-e043db98a60f"
          },
          {
            "name": "Cheap Tier Unit Share %",
            "description": "Units from the cheapest 40% of articles.",
            "displayFolder": "Page 05 Basket",
            "expression": "DIVIDE ( CALCULATE ( [Units], agg_sales_daily[price_tier] <= 2 ), [Units] )",
            "formatString": "0.0%",
            "lineageTag": "b2fc5648-15df-4f2b-bc1a-1fc8140da92c"
          },
          {
            "name": "Top Tier Unit Share %",
            "description": "Units from the priciest 20% of articles.",
            "displayFolder": "Page 05 Basket",
            "expression": "DIVIDE ( CALCULATE ( [Units], agg_sales_daily[price_tier] = 5 ), [Units] )",
            "formatString": "0.0%",
            "lineageTag": "e4fcf149-1235-4589-a08d-45e3c5250caf"
          },
          {
            "name": "Price Tier Unit Share %",
            "description": "Share of units in the price tier.",
            "displayFolder": "Page 05 Basket",
            "expression": "DIVIDE ( [Units], CALCULATE ( [Units], REMOVEFILTERS ( agg_sales_daily[price_tier_label], agg_sales_daily[price_tier] ) ) )",
            "formatString": "0%",
            "lineageTag": "d1957f99-8393-4d11-9556-d4d212c7567c"
          },
          {
            "name": "Ref Online Share",
            "description": "Rail line.",
            "displayFolder": "Page 05 Basket",
            "expression": "\"vs \" & FORMAT ( [Online Share Season Before %], \"0%\" ) & \" the year before\"",
            "lineageTag": "6bcfe9b1-3cbf-430d-beb2-a165fd41c69d"
          },
          {
            "name": "Ref Units YoY",
            "description": "Rail line.",
            "displayFolder": "Page 05 Basket",
            "expression": "\"Online \" & FORMAT ( [Online Units Season YoY %], \"+0%;-0%\" ) & \"  ·  store \" & FORMAT ( [Store Units Season YoY %], \"+0%;-0%\" )",
            "lineageTag": "225f34bf-c082-4013-ac59-4d2d0739ab7c"
          },
          {
            "name": "Ref Top Group",
            "description": "Rail line.",
            "displayFolder": "Page 05 Basket",
            "expression": "[Top Group Name] & \" sells the most\"",
            "lineageTag": "d6b1e6b3-dc0a-428f-90ff-52242347ae2a"
          },
          {
            "name": "Ref Biggest Gain",
            "description": "Rail line.",
            "displayFolder": "Page 05 Basket",
            "expression": "[Biggest Gain Group] & \"  ·  biggest drop: \" & [Biggest Loss Group]",
            "lineageTag": "26ee8acb-7b64-4f3c-888d-c529bf9ab65c"
          },
          {
            "name": "Headline 05",
            "description": "Page 05 headline.",
            "displayFolder": "Page 05 Basket",
            "expression": [
              "[Scope Label] & \": online rose from \" & FORMAT ( [Online Share Season Before %], \"0%\" ) & \" to \"",
              "    & FORMAT ( [Online Share Season COVID %], \"0%\" ) & \" of items sold in COVID\""
            ],
            "lineageTag": "a0ab7263-77ed-4271-9257-0b8ddec5422d"
          },
          {
            "name": "Subline 05",
            "description": "Page 05 supporting line.",
            "displayFolder": "Page 05 Basket",
            "expression": [
              "VAR Season = CALCULATE ( MAX ( dim_date[same_season_period] ), dim_date[same_season_sort] = 2 )",
              "RETURN",
              "    FORMAT ( [Units] / 1000000, \"0.0\" ) & \"M items sold  ·  COVID (\" & Season",
              "        & \") is compared with the same months a year earlier  ·  price groups split products into five equal bands\""
            ],
            "lineageTag": "3f9ea5b0-9265-40a6-b82d-4818a8e8574b"
          },
          {
            "name": "Title 05 Ribbon",
            "description": "Page 05 ribbon title.",
            "displayFolder": "Page 05 Basket",
            "expression": [
              "VAR Ranked = TOPN ( 2, VALUES ( agg_sales_daily[index_group] ), [Units], DESC )",
              "VAR SecondGroup = TOPN ( 1, Ranked, [Units], ASC )",
              "VAR SecondName = CONCATENATEX ( SecondGroup, agg_sales_daily[index_group], \", \" )",
              "RETURN",
              "    [Top Group Name] & \" is \" & FORMAT ( [Top Group Share %], \"0%\" ) & \" of items sold; \"",
              "        & IF ( SecondName = \"Divided\", \"Divided, H&M's young fashion line,\", SecondName )",
              "        & \" is next at \" & FORMAT ( DIVIDE ( SUMX ( SecondGroup, [Units] ), [Units] ), \"0%\" )"
            ],
            "lineageTag": "adb9953b-0622-4f49-bef6-440c2ae07ea2"
          },
          {
            "name": "Title 05 Donut",
            "description": "Page 05 price tier title.",
            "displayFolder": "Page 05 Basket",
            "expression": "\"Cheapest 40% of products make \" & FORMAT ( [Cheap Tier Unit Share %], \"0%\" ) & \" of items sold\"",
            "lineageTag": "89ef09c1-08f2-4afc-9e82-08aa720c8699"
          },
          {
            "name": "Product Unit Share %",
            "description": "Share of units within the visible product groups.",
            "displayFolder": "Page 05 Basket",
            "expression": [
              "DIVIDE (",
              "    [Units],",
              "    CALCULATE ( [Units], REMOVEFILTERS ( agg_sales_daily[product_group], agg_sales_daily[product_group_label] ) )",
              ")"
            ],
            "formatString": "0.0%",
            "lineageTag": "a7a5d0df-90be-4977-b0b4-ac5355267bf3"
          },
          {
            "name": "Product Share Shift Pts",
            "description": "Change in product group unit share, COVID season vs the same season a year before, in percentage points.",
            "displayFolder": "Page 05 Basket",
            "expression": [
              "(",
              "    CALCULATE ( [Product Unit Share %], dim_date[same_season_sort] = 2 )",
              "        - CALCULATE ( [Product Unit Share %], dim_date[same_season_sort] = 1 )",
              ") * 100"
            ],
            "formatString": "+0.0\" pts\";-0.0\" pts\";0.0\" pts\"",
            "lineageTag": "1f06181b-e162-4843-a5e1-31263a4d0b5f"
          },
          {
            "name": "Title 05 Waterfall",
            "description": "Page 05 waterfall title.",
            "displayFolder": "Page 05 Basket",
            "expression": [
              "\"In COVID, \" & LOWER ( [Biggest Gain Group] ) & \" won the most share of items sold (\"",
              "    & FORMAT ( [Biggest Gain Pts], \"+0.0;-0.0\" ) & \" points); \" & LOWER ( [Biggest Loss Group] )",
              "    & \" lost the most (\" & FORMAT ( [Biggest Loss Pts], \"+0.0;-0.0\" ) & \")\""
            ],
            "lineageTag": "6f7dc249-12b2-4f3d-b218-b7602cede750"
          },
          {
            "name": "Waterfall Shift Pts",
            "description": "Product group share shift, hidden when smaller than 0.05 pts so the waterfall shows only real movers.",
            "displayFolder": "Page 05 Basket",
            "expression": [
              "VAR Shift = [Product Share Shift Pts]",
              "RETURN",
              "    IF ( ABS ( Shift ) >= 0.05, Shift )"
            ],
            "formatString": "+0.0\" pts\";-0.0\" pts\";0.0\" pts\"",
            "lineageTag": "f3c91a41-1955-4883-b1bd-e9925e607f91"
          },
          {
            "name": "Store Unit Share %",
            "description": "Share of units bought in store.",
            "displayFolder": "Page 05 Basket",
            "expression": "1 - [Online Unit Share %]",
            "formatString": "0%",
            "lineageTag": "b3e8647c-6469-4a9a-bba8-e3da496f4813"
          },
          {
            "name": "Title 05 Online",
            "description": "Page 05 online share by product group title.",
            "displayFolder": "Page 05 Basket",
            "expression": [
              "VAR AllUnits = [Units]",
              "VAR Groups =",
              "    FILTER (",
              "        ADDCOLUMNS ( VALUES ( agg_sales_daily[product_group_label] ), \"@Units\", [Units], \"@Online\", [Online Unit Share %] ),",
              "        [@Units] >= 0.01 * AllUnits",
              "    )",
              "VAR MostOnline = TOPN ( 1, Groups, [@Online], DESC )",
              "VAR LeastOnline = TOPN ( 1, Groups, [@Online], ASC )",
              "RETURN",
              "    FORMAT ( MAXX ( MostOnline, [@Online] ), \"0%\" ) & \" of \"",
              "        & LOWER ( CONCATENATEX ( MostOnline, agg_sales_daily[product_group_label], \", \" ) )",
              "        & \" sell online vs \" & FORMAT ( MAXX ( LeastOnline, [@Online] ), \"0%\" ) & \" of \"",
              "        & LOWER ( CONCATENATEX ( LeastOnline, agg_sales_daily[product_group_label], \", \" ) )"
            ],
            "lineageTag": "d4c2db72-9b64-4e68-8447-ea124ae56b7f"
          },
          {
            "name": "Spend at Stake",
            "description": "A quarter of each scored customer's spend over the past year (scaled).",
            "displayFolder": "6 Where to act",
            "expression": "SUM ( rpt_customer[quarterly_spend_at_stake] )",
            "formatString": "#,0.0",
            "lineageTag": "f8688fa5-e824-485e-a265-26b5f05ecdc5"
          },
          {
            "name": "Sales at Risk %",
            "description": "Share of quarterly sales expected to be lost: value at risk over spend at stake.",
            "displayFolder": "Page 06 Act",
            "expression": "DIVIDE ( [Value at Risk], [Spend at Stake] )",
            "formatString": "0.0%",
            "lineageTag": "32009acd-7455-40f9-b373-3d12e76acb1d"
          },
          {
            "name": "Save Rate Selected",
            "description": "Save rate picked on the chips; 20% if none.",
            "displayFolder": "Page 06 Act",
            "expression": "SELECTEDVALUE ( 'Save Rate'[Save Rate], 0.2 )",
            "formatString": "0%",
            "lineageTag": "64ae973c-44d8-40de-aeaa-1f13ee0af3b7"
          },
          {
            "name": "Customers Kept",
            "description": "Likely leavers kept at the chosen save rate.",
            "displayFolder": "Page 06 Act",
            "expression": "[Expected Churners] * [Save Rate Selected]",
            "formatString": "#,0",
            "lineageTag": "82b95453-3e82-4fa0-8ad9-6ff5cb409478"
          },
          {
            "name": "Sales Protected %",
            "description": "Quarterly sales protected at the chosen save rate, as a share of quarterly sales.",
            "displayFolder": "Page 06 Act",
            "expression": "DIVIDE ( [Value at Risk] * [Save Rate Selected], [Spend at Stake] )",
            "formatString": "0.0%",
            "lineageTag": "c1780615-5ee2-4100-b81d-5533253bdc06"
          },
          {
            "name": "Band Risk Share %",
            "description": "Share of sales at risk held by the customer band.",
            "displayFolder": "Page 06 Act",
            "expression": [
              "DIVIDE (",
              "    [Value at Risk],",
              "    CALCULATE ( [Value at Risk], REMOVEFILTERS ( rpt_customer[risk_band_label], rpt_customer[risk_band_sort] ) )",
              ")"
            ],
            "formatString": "0%",
            "lineageTag": "870be07d-6bb6-4011-b0bf-197544072a24"
          },
          {
            "name": "Cumulative Risk Share %",
            "description": "Running share of sales at risk from the top band down.",
            "displayFolder": "Page 06 Act",
            "expression": [
              "VAR CurrentBand = MAX ( rpt_customer[risk_band_sort] )",
              "RETURN",
              "    DIVIDE (",
              "        CALCULATE ( [Value at Risk], rpt_customer[risk_band_sort] <= CurrentBand, REMOVEFILTERS ( rpt_customer[risk_band_label] ) ),",
              "        CALCULATE ( [Value at Risk], REMOVEFILTERS ( rpt_customer[risk_band_label], rpt_customer[risk_band_sort] ) )",
              "    )"
            ],
            "formatString": "0%",
            "lineageTag": "29261c46-35a3-4478-ac23-789133d51576"
          },
          {
            "name": "Color 06 Band",
            "description": "Top 10% band in red.",
            "displayFolder": "Page 06 Act",
            "expression": "IF ( MAX ( rpt_customer[risk_band_sort] ) = 1, \"#D7192D\", \"#111111\" )",
            "lineageTag": "beb14c79-8c16-4e1c-94a0-0f70f95c5193"
          },
          {
            "name": "Segment Risk Share %",
            "description": "Share of sales at risk held by the customer group.",
            "displayFolder": "Page 06 Act",
            "expression": [
              "DIVIDE (",
              "    [Value at Risk],",
              "    CALCULATE ( [Value at Risk], REMOVEFILTERS ( rpt_customer[rfm_segment], rpt_customer[segment_sort_order] ) )",
              ")"
            ],
            "formatString": "0%",
            "lineageTag": "3509bda6-4dc0-4fe5-be2f-d0772d5e9934"
          },
          {
            "name": "Segment Action",
            "description": "Suggested next step per customer group (analyst recommendation).",
            "displayFolder": "Page 06 Act",
            "expression": [
              "SWITCH (",
              "    SELECTEDVALUE ( rpt_customer[rfm_segment] ),",
              "    \"Champions\", \"Reward with early access, not discounts\",",
              "    \"Loyal\", \"Thank them and suggest new categories\",",
              "    \"Potential loyalists\", \"Nudge a third order with a bundle\",",
              "    \"New or occasional\", \"Welcome series and a second-order offer\",",
              "    \"Needs attention\", \"Personal picks based on past buys\",",
              "    \"At risk\", \"Win-back offer within two weeks\",",
              "    \"Hibernating\", \"Low-cost reminder emails only\",",
              "    \"Lost\", \"Don't spend; let them go\"",
              ")"
            ],
            "lineageTag": "3ac4f60d-48cd-4947-8c19-edcc5de410db"
          },
          {
            "name": "Top Segment Name",
            "description": "Customer group holding the most sales at risk.",
            "displayFolder": "Page 06 Act",
            "expression": "CONCATENATEX ( TOPN ( 1, VALUES ( rpt_customer[rfm_segment] ), [Value at Risk], DESC ), rpt_customer[rfm_segment], \", \" )",
            "lineageTag": "8c45a956-30b3-40be-ae38-25fbb75a94a4"
          },
          {
            "name": "Top Segment Risk Share %",
            "description": "Share of sales at risk in the top customer group.",
            "displayFolder": "Page 06 Act",
            "expression": [
              "VAR TopSegment = TOPN ( 1, VALUES ( rpt_customer[rfm_segment] ), [Value at Risk], DESC )",
              "RETURN",
              "    DIVIDE ( SUMX ( TopSegment, [Value at Risk] ), [Value at Risk] )"
            ],
            "formatString": "0%",
            "lineageTag": "9aee28af-d2fb-4aec-b8f2-024fff352ebb"
          },
          {
            "name": "Ref Top Decile",
            "description": "Rail line.",
            "displayFolder": "Page 06 Act",
            "expression": "\"Just \" & FORMAT ( [Top Decile Customers] / 1000, \"#,0\" ) & \"K customers\"",
            "lineageTag": "49f2e42c-8399-45db-9913-0aa2dd4324a1"
          },
          {
            "name": "Ref Sales at Risk",
            "description": "Rail line.",
            "displayFolder": "Page 06 Act",
            "expression": "\"If nothing changes next quarter\"",
            "lineageTag": "082f292d-b327-4e23-9605-498a2875fc17"
          },
          {
            "name": "Ref Expected Churners",
            "description": "Rail line.",
            "displayFolder": "Page 06 Act",
            "expression": "\"Out of \" & FORMAT ( [Scored Customers] / 1000, \"#,0\" ) & \"K recent customers\"",
            "lineageTag": "7fcc2794-142a-40ec-bf45-9175eef36c8c"
          },
          {
            "name": "Ref Top Segment",
            "description": "Rail line.",
            "displayFolder": "Page 06 Act",
            "expression": "[Top Segment Name] & \" customers\"",
            "lineageTag": "cd6d3250-6b69-4d4b-8d8d-c06cf3b70805"
          },
          {
            "name": "Ref Customers Kept",
            "description": "Simulator line.",
            "displayFolder": "Page 06 Act",
            "expression": "\"Of \" & FORMAT ( [Expected Churners] / 1000, \"#,0\" ) & \"K likely to stop\"",
            "lineageTag": "aa82cdc5-3421-4574-9a5a-d1863ce7fa91"
          },
          {
            "name": "Ref Sales Protected",
            "description": "Simulator line.",
            "displayFolder": "Page 06 Act",
            "expression": "\"Out of \" & FORMAT ( [Sales at Risk %], \"0%\" ) & \" at risk\"",
            "lineageTag": "ed7af747-9693-4a95-b84e-4df1f8987aca"
          },
          {
            "name": "Ref Contact First",
            "description": "Simulator line.",
            "displayFolder": "Page 06 Act",
            "expression": "\"They hold \" & FORMAT ( [Top Decile Value at Risk Share %], \"0%\" ) & \" of sales at risk\"",
            "lineageTag": "244e41ee-d224-424e-a4e5-02daad675cbb"
          },
          {
            "name": "Headline 06",
            "description": "Page 06 headline.",
            "displayFolder": "Page 06 Act",
            "expression": "[Scope Label] & \": the top 10% of customers hold \" & FORMAT ( [Top Decile Value at Risk Share %], \"0%\" ) & \" of the sales at risk\"",
            "lineageTag": "3f758044-8b69-4bb8-a401-829ea71d8358"
          },
          {
            "name": "Subline 06",
            "description": "Page 06 supporting line.",
            "displayFolder": "Page 06 Act",
            "expression": "\"Sales at risk = chance of stopping × a quarter of last year's spend  ·  pick a save rate below to test a retention campaign  ·  prices scaled by H&M\"",
            "lineageTag": "aef91a80-05ef-439a-8954-6e1543d6f533"
          },
          {
            "name": "Title 06 Bands",
            "description": "Page 06 band chart title.",
            "displayFolder": "Page 06 Act",
            "expression": [
              "VAR Top30 =",
              "    DIVIDE (",
              "        CALCULATE ( [Value at Risk], rpt_customer[risk_band_sort] <= 3 ),",
              "        CALCULATE ( [Value at Risk], rpt_customer[is_scored] = TRUE () )",
              "    )",
              "RETURN",
              "    \"The top 10% of customers hold \" & FORMAT ( [Top Decile Value at Risk Share %], \"0%\" )",
              "        & \" of sales at risk; the top 30%, \" & FORMAT ( Top30, \"0%\" )"
            ],
            "lineageTag": "1e2c3b24-32e6-48f2-8d82-b2a491f19732"
          },
          {
            "name": "Title 06 Tree",
            "description": "Page 06 decomposition tree title.",
            "displayFolder": "Page 06 Act",
            "expression": [
              "VAR TopChannel = TOPN ( 1, VALUES ( rpt_customer[channel_preference] ), [Value at Risk], DESC )",
              "VAR ChannelName = CONCATENATEX ( TopChannel, rpt_customer[channel_preference], \", \" )",
              "VAR ChannelShare = DIVIDE ( SUMX ( TopChannel, [Value at Risk] ), [Value at Risk] )",
              "RETURN",
              "    \"Customers who shop \"",
              "        & SWITCH ( ChannelName, \"Online only\", \"only online\", \"Store only\", \"only in stores\", \"Omnichannel\", \"both ways\", ChannelName )",
              "        & \" hold \" & FORMAT ( ChannelShare, \"0%\" ) & \" of sales at risk\""
            ],
            "lineageTag": "d962f8d6-49d4-4087-904b-e4c5f1d7e3d0"
          },
          {
            "name": "Title 06 Actions",
            "description": "Page 06 action table title.",
            "displayFolder": "Page 06 Act",
            "expression": "\"Start with \" & [Top Segment Name] & \": \" & FORMAT ( [Top Segment Risk Share %], \"0%\" ) & \" of sales at risk\"",
            "lineageTag": "9dd7638f-7d31-41d9-bbad-21d89670369d"
          },
          {
            "name": "Title 06 Simulator",
            "description": "Page 06 simulator title.",
            "displayFolder": "Page 06 Act",
            "expression": [
              "\"Keep \" & FORMAT ( [Save Rate Selected], \"0%\" ) & \" of likely leavers and we protect \"",
              "    & FORMAT ( [Sales Protected %], \"0.0%\" ) & \" of quarterly sales\""
            ],
            "lineageTag": "9a3452d4-1afc-49f3-9187-e43e800768aa"
          },
          {
            "name": "Notes Customers",
            "description": "All customers in the data.",
            "displayFolder": "Page 07 Notes",
            "expression": "CALCULATE ( [Customers], REMOVEFILTERS () )",
            "formatString": "#,0",
            "lineageTag": "01a40a96-899a-4a82-b078-981ad9fcb360"
          },
          {
            "name": "Notes Items",
            "description": "All items bought in the data.",
            "displayFolder": "Page 07 Notes",
            "expression": "CALCULATE ( [Units], REMOVEFILTERS () )",
            "formatString": "#,0",
            "lineageTag": "27234250-78a2-4b17-9b19-ee1eecefaeab"
          },
          {
            "name": "Notes Products",
            "description": "All products in the catalog.",
            "displayFolder": "Page 07 Notes",
            "expression": "CALCULATE ( COUNTROWS ( dim_product ), REMOVEFILTERS () )",
            "formatString": "#,0",
            "lineageTag": "2cb57b39-aa2d-481c-87be-688b0a6aea12"
          },
          {
            "name": "Notes Months",
            "description": "Months covered by the data.",
            "displayFolder": "Page 07 Notes",
            "expression": [
              "VAR PeriodStart = CALCULATE ( MIN ( dim_date[date] ), REMOVEFILTERS () )",
              "VAR PeriodEnd = CALCULATE ( MAX ( dim_date[date] ), REMOVEFILTERS () )",
              "RETURN",
              "    DATEDIFF ( PeriodStart, PeriodEnd, MONTH ) + 1"
            ],
            "formatString": "0",
            "lineageTag": "f9c4625f-af21-4dd5-a4f7-701ad51cdb4f"
          },
          {
            "name": "Ref Notes Customers",
            "description": "Rail line.",
            "displayFolder": "Page 07 Notes",
            "expression": "\"Club members with a customer record\"",
            "lineageTag": "d83a3ca5-6b0c-40ac-a61f-9451aa873d45"
          },
          {
            "name": "Ref Notes Items",
            "description": "Rail line.",
            "displayFolder": "Page 07 Notes",
            "expression": "\"Every item bought online or in store\"",
            "lineageTag": "bb9ab929-9cfa-4a0b-a888-fce1b3519a2f"
          },
          {
            "name": "Ref Notes Products",
            "description": "Rail line.",
            "displayFolder": "Page 07 Notes",
            "expression": "\"Products in the H&M catalog\"",
            "lineageTag": "9b05ade4-e046-41eb-a046-bde5e3cfdd7c"
          },
          {
            "name": "Ref Notes Months",
            "description": "Rail line.",
            "displayFolder": "Page 07 Notes",
            "expression": [
              "FORMAT ( CALCULATE ( MIN ( dim_date[date] ), REMOVEFILTERS () ), \"mmm yyyy\" ) & \" to \"",
              "    & FORMAT ( CALCULATE ( MAX ( dim_date[date] ), REMOVEFILTERS () ), \"mmm yyyy\" )"
            ],
            "lineageTag": "a776cd26-fb18-449a-92d9-e21069a2b7f4"
          },
          {
            "name": "Headline Notes",
            "description": "Notes headline.",
            "displayFolder": "Page 07 Notes",
            "expression": "\"How this report was built, and how to read it\"",
            "lineageTag": "399e72e2-ec44-4e97-8671-8ac092c743bf"
          },
          {
            "name": "Subline Notes",
            "description": "Notes supporting line.",
            "displayFolder": "Page 07 Notes",
            "expression": "\"Every number is calculated from the data and updates on refresh  ·  aggregates only, no customer IDs  ·  data refreshed monthly\"",
            "lineageTag": "c94a359b-434e-4bd7-a4f6-779b804ee4c2"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i44FAA==\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t])",
                "in",
                "  Source"
              ],
              "type": "m"
            }
          }
        ]
      },
