            "name": "product_group_label",
            "dataType": "string",
            "expression": [
              "SWITCH (",
              "    agg_sales_daily[product_group],",
              "    \"Garment Upper body\", \"Tops\",",
              "    \"Garment Lower body\", \"Bottoms\",",
              "    \"Garment Full body\", \"Dresses & jumpsuits\",",
              "    \"Socks & Tights\", \"Socks & tights\",",
              "    \"Underwear/nightwear\", \"Underwear & nightwear\",",
              "    \"Garment and Shoe care\", \"Clothing care\",",
              "    \"Interior textile\", \"Home textiles\",",
              "    \"Items\", \"Other items\",",
              "    \"Unknown\", \"Uncategorized\",",
              "    \"Fun\", \"Novelty\",",
              "    agg_sales_daily[product_group]",
              ")"
