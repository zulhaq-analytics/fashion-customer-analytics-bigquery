            ],
            "dataType": "int64",
            "formatString": "0",
            "lineageTag": "daad4cf2-af45-4fba-9053-bb908db1ba8a",
            "sourceColumn": "buyers",
            "summarizeBy": "sum"
          },
          {
            "name": "avg_price",
            "annotations": [
