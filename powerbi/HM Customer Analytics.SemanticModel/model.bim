            "name": "cohort_period",
            "dataType": "string",
            "expression": [
              "SWITCH (",
              "    TRUE (),",
              "    cohort_retention[cohort_type] <> \"Standard\", BLANK (),",
              "    cohort_retention[cohort_month] >= DATE ( 2020, 3, 1 ), \"COVID joiners\",",
              "    \"Pre-COVID joiners\"",
              ")"
