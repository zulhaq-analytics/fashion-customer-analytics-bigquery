          {
            "name": "churn_risk_band_sort",
            "dataType": "int64",
            "expression": "SWITCH ( TRUE (), ISBLANK ( rpt_customer[churn_probability] ), 4, rpt_customer[churn_probability] >= 0.7, 1, rpt_customer[churn_probability] >= 0.4, 2, 3 )",
            "isDataTypeInferred": true,
            "isHidden": true,
