              "FORMAT ( rpt_churn_drivers[cutoff_date], \"mmm yyyy\" )",
              "    & IF ( rpt_churn_drivers[data_split] = \"covid_lockdown\", \" (lockdown)\" )"
            ],
            "isDataTypeInferred": true,
