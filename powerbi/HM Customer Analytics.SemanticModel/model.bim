          {
            "name": "recency_sort",
            "dataType": "double",
            "expression": [
              "VAR Band = rpt_churn_drivers[recency_band]",
              "VAR Dot = SEARCH ( \". \", Band, 1, 0 )",
              "RETURN",
              "    IF ( Dot > 0 && Dot <= 3, VALUE ( LEFT ( Band, Dot - 1 ) ), 99 )"
            ],
            "formatString": "0",
            "isDataTypeInferred": true,
            "isHidden": true,
            "lineageTag": "a3440b3d-b5c4-4c09-9235-6aa83c95a007",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "recency_label",
            "dataType": "string",
            "expression": [
              "VAR Band = rpt_churn_drivers[recency_band]",
              "VAR Dot = SEARCH ( \". \", Band, 1, 0 )",
              "RETURN",
              "    IF ( Dot > 0 && Dot <= 3, MID ( Band, Dot + 2, 100 ), Band )"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "82b253a1-0322-494b-8aaf-def69b292241",
            "sortByColumn": "recency_sort",
            "summarizeBy": "none",
            "type": "calculated"
          },
