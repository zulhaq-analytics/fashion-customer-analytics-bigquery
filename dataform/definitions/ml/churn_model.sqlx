config {
  type: "operations",
  schema: "hm_marts",
  hasOutput: true,
  description: "BigQuery ML logistic regression predicting 90-day churn. Trained on the train split only (Sep and Dec 2019 cutoffs); evaluated separately on the Jun 2020 test split."
}

CREATE OR REPLACE MODEL ${self()}
OPTIONS (
  model_type = 'LOGISTIC_REG',
  input_label_cols = ['churned_90d'],
  data_split_method = 'NO_SPLIT',
  enable_global_explain = TRUE
) AS
SELECT
  recency_days,
  tenure_days,
  orders_90d,
  orders_365d,
  units_365d,
  spend_365d,
  avg_order_value,
  online_share_365d,
  distinct_articles_365d,
  age,
  club_member_status,
  fashion_news_frequency,
  is_fashion_news_subscriber,
  churned_90d
FROM ${ref("churn_labels")}
WHERE data_split = 'train'
