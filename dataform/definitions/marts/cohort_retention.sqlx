config {
  type: "table",
  schema: "hm_marts",
  description: "Cohort retention by age band: one row per acquisition cohort month, months since first purchase and customer age band. Cohorts before Mar 2019 are labeled Warm-up because the data window starts Sep 2018 and those cohorts mix in pre-existing customers. The last data month is partial. To combine age bands, divide summed active_customers by summed cohort_size.",
  columns: {
    cohort_month: "Month of first purchase in the data window",
    months_since_first_purchase: "0 = cohort month",
    age_band: "Customer age band (joins to the Power BI age filter)",
    activity_month: "Calendar month being measured",
    cohort_size: "Customers in the cohort and age band",
    active_customers: "Cohort customers in the age band who purchased in the activity month",
    retention_rate: "active_customers / cohort_size within the age band",
    cohort_type: "Warm-up (before Mar 2019), Standard, or Partial month (last data month)",
    is_partial_activity_month: "Activity month is the last, partial month of the data window"
  },
  assertions: {
    uniqueKey: ["cohort_month", "months_since_first_purchase", "age_band"],
    nonNull: ["cohort_month", "months_since_first_purchase", "age_band", "cohort_size", "active_customers"],
    rowConditions: [
      "retention_rate BETWEEN 0 AND 1",
      "months_since_first_purchase > 0 OR retention_rate = 1"
    ]
  }
}

WITH activity AS (
  SELECT
    a.*,
    c.age_band
  FROM ${ref("customer_monthly_activity")} AS a
  JOIN ${ref("dim_customer")} AS c
    ON a.customer_id = c.customer_id
),

bounds AS (
  SELECT MAX(activity_month) AS last_month FROM activity
),

cohort_sizes AS (
  SELECT
    cohort_month,
    age_band,
    COUNT(DISTINCT customer_id) AS cohort_size
  FROM activity
  WHERE months_since_first_purchase = 0
  GROUP BY cohort_month, age_band
),

retention AS (
  SELECT
    cohort_month,
    months_since_first_purchase,
    age_band,
    COUNT(DISTINCT customer_id) AS active_customers,
    SUM(orders) AS orders,
    SUM(sales_amount) AS sales_amount
  FROM activity
  GROUP BY cohort_month, months_since_first_purchase, age_band
)

SELECT
  r.cohort_month,
  r.months_since_first_purchase,
  r.age_band,
  DATE_ADD(r.cohort_month, INTERVAL r.months_since_first_purchase MONTH) AS activity_month,
  s.cohort_size,
  r.active_customers,
  ROUND(SAFE_DIVIDE(r.active_customers, s.cohort_size), 6) AS retention_rate,
  r.orders,
  ROUND(r.sales_amount, 6) AS sales_amount,
  ROUND(SAFE_DIVIDE(r.sales_amount, s.cohort_size), 6) AS sales_per_cohort_customer,
  CASE
    WHEN r.cohort_month = b.last_month THEN 'Partial month'
    WHEN r.cohort_month < DATE '2019-03-01' THEN 'Warm-up'
    ELSE 'Standard'
  END AS cohort_type,
  DATE_ADD(r.cohort_month, INTERVAL r.months_since_first_purchase MONTH) = b.last_month AS is_partial_activity_month
FROM retention AS r
JOIN cohort_sizes AS s
  ON r.cohort_month = s.cohort_month
 AND r.age_band = s.age_band
CROSS JOIN bounds AS b
