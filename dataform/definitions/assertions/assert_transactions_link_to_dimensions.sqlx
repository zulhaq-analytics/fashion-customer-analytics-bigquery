config {
  type: "assertion",
  description: "Every purchase must link to a known customer and a known article. Returns the orphaned keys; zero rows means pass."
}

SELECT DISTINCT
  'customer_id not in stg_customers' AS issue,
  t.customer_id AS orphan_key
FROM ${ref("stg_transactions")} AS t
LEFT JOIN ${ref("stg_customers")} AS c
  ON t.customer_id = c.customer_id
WHERE c.customer_id IS NULL

UNION ALL

SELECT DISTINCT
  'article_id not in stg_articles' AS issue,
  t.article_id AS orphan_key
FROM ${ref("stg_transactions")} AS t
LEFT JOIN ${ref("stg_articles")} AS a
  ON t.article_id = a.article_id
WHERE a.article_id IS NULL
